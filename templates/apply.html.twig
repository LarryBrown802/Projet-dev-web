{% extends 'base.html.twig' %}

{% block title %}Postuler - {{ poste }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/apply.css">
{% endblock %}

{% block content %}
<main class="container apply-container">

    <div class="apply-head">
        <div class="apply-icon">
            <i class="fa-solid fa-paper-plane"></i>
        </div>
        <h1>Formulaire de candidature</h1>
        <p class="page-subtitle">Vous postulez pour <strong>{{ poste }}</strong> chez <strong>{{ entreprise }}</strong>.</p>
    </div>

    {% if message %}
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i> {{ message }}
        </div>
    {% endif %}

    {% if error %}
        <div class="alert alert-error">
            <i class="fa-solid fa-circle-exclamation"></i> {{ error }}
        </div>
    {% endif %}

    <form class="apply-form" action="/index.php?page=apply" method="POST" enctype="multipart/form-data">

        {# ← Champs hidden pour conserver les infos entre GET et POST #}
        <input type="hidden" name="offer_id"   value="{{ offer_id ?? '' }}">
        <input type="hidden" name="poste"      value="{{ poste }}">
        <input type="hidden" name="entreprise" value="{{ entreprise }}">

        <h3 class="apply-section-title">Informations personnelles</h3>

        <div class="apply-grid-2">
            <div class="apply-field">
                <label for="prenom">Prénom <span class="required">*</span></label>
                <input type="text" id="prenom" name="prenom" required />
            </div>
            <div class="apply-field">
                <label for="nom">Nom <span class="required">*</span></label>
                <input type="text" id="nom" name="nom" required />
            </div>
        </div>

        <div class="apply-grid-2">
            <div class="apply-field">
                <label for="email">Email <span class="required">*</span></label>
                <input type="email" id="email" name="email" required />
            </div>
            <div class="apply-field">
                <label for="tel">Téléphone <span class="required">*</span></label>
                <input type="tel" id="tel" name="tel" required />
            </div>
        </div>

        <h3 class="apply-section-title">Votre profil</h3>

        <div class="apply-field apply-field--icon">
            <label for="linkedin">Lien LinkedIn ou Portfolio</label>
            <div class="apply-input-wrap">
                <i class="fa-brands fa-linkedin"></i>
                <input type="url" id="linkedin" name="linkedin" placeholder="https://..." />
            </div>
        </div>

        <div class="apply-field apply-field--icon">
            <label for="cv">Curriculum Vitae (PDF) <span class="required">*</span></label>
            <div class="apply-input-wrap">
                <i class="fa-solid fa-file-pdf"></i>
                <input type="file" id="cv" name="cv" accept=".pdf" required />
            </div>
        </div>

        <div class="apply-field">
            <label for="lettre">Message / Lettre de motivation</label>
            <textarea id="lettre" name="lettre" rows="5"
                      placeholder="Expliquez pourquoi vous êtes le candidat idéal…"></textarea>
        </div>

        <div class="apply-actions">
            <a href="/index.php?page=offers" class="apply-btn apply-btn--cancel">Annuler</a>
            <button type="submit" class="apply-btn apply-btn--submit">Envoyer ma candidature</button>
        </div>

    </form>
</main>
{% endblock %}


{% block javascripts %}
    <script>
        // Script pour afficher les messages de succès ou d'erreur
        document.addEventListener('DOMContentLoaded', function() {
            const messageBox = document.querySelector('.message-box');
            if (messageBox) {
                setTimeout(() => {
                    messageBox.style.opacity = '0';
                    setTimeout(() => messageBox.remove(), 500);
                }, 5000);
            }
        });
    </script>
{% endblock %}