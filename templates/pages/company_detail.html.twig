{% extends 'pages/base.html.twig' %}

{% block title %}{{ company.name }} Détails - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/entreprise.css">
{% endblock %}

{% block content %}

    <div class="company-banner">
        <div class="company-banner__icon">
            <i class="fa-solid fa-building"></i>
        </div>
    </div>

    <main class="container company-detail-main">

        <div class="company-detail-card">

            <div class="company-detail-header">
                <div>
                    <h1>{{ company.name }}</h1>

                    <div class="company-detail-stars">
                        {% set note = company.average_mark ?? 0 %}
                        {% for i in 1..5 %}
                            {% if i <= note %}
                                <i class="fa-solid fa-star"></i>
                            {% else %}
                                <i class="fa-regular fa-star"></i>
                            {% endif %}
                        {% endfor %}
                        <span class="company-detail-note">{{ note }}/5</span>
                    </div>
                </div>

                <div class="company-contact-box">
                    <h3>Contact</h3>
                    <p><i class="fa-solid fa-phone"></i>{{ company.number ?? '—' }}</p>
                    <p><i class="fa-solid fa-envelope"></i>{{ company.email ?? '—' }}</p>
                </div>
            </div>

            <hr class="company-divider">

            <h2>À propos de nous</h2>
            <p class="company-description">
                {{ company.description ?? 'Aucune description disponible.' }}
            </p>
            <p class="company-description">
                Chez {{ company.name }}, nous nous engageons à offrir le meilleur environnement de travail pour nos collaborateurs.
                Rejoignez une équipe dynamique et participez à des projets innovants !
            </p>

            <hr class="company-divider">

            <div class="company-offers-block">
                <h3>Cette entreprise recrute !</h3>
                <p class="company-offers-count">
                    <strong>{{ company.offres_count ?? 0 }}</strong> offres sont actuellement disponibles.
                </p>
                <a href="/index.php?page=offers&search={{ company.name }}" class="btn-voir company-offers-btn">
                    Voir les offres de {{ company.name }}
                </a>
            </div>

        </div>

        <div class="company-back">
            <a href="/index.php?page=company">
                <i class="fa-solid fa-arrow-left"></i> Retour aux entreprises
            </a>
        </div>

    </main>
{% endblock %}