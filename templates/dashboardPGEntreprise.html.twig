{# 1. On appelle le squelette de base #}
{% extends 'base.html.twig' %}

{# 2. On définit le titre de l'onglet #}
{% block title %}LEMS - Entreprises (Pilote){% endblock %}

{# 3. CSS spécifique au panel pilote #}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/pilote.css">
{% endblock %}

{# 4. Contenu principal #}
{% block content %}
    <main class="container">
        <div class="table-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Stagiaires ayant postulé</th>
                        <th>Note moy.</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {# THE DYNAMIC LOOP #}
                    {% for entreprise in entreprises %}
                        <tr>
                            <td><strong>{{ entreprise.nom }}</strong></td>
                            <td>{{ entreprise.email }}</td>
                            <td>{{ entreprise.tel }}</td>
                            <td>{{ entreprise.candidats }}</td>
                            <td>
                                <span class="stars">
                                    {% for i in 1..5 %}
                                        {% if i <= entreprise.note %}
                                            <i class="fa-solid fa-star"></i>
                                        {% else %}
                                            <i class="fa-regular fa-star"></i>
                                        {% endif %}
                                    {% endfor %}
                                    <span style="margin-left:4px;font-weight:800">{{ entreprise.note }}/5</span>
                                </span>
                            </td>
                            <td class="actions-cell">
                                <button class="btn-icon btn-edit" title="Modifier" data-nom="{{ entreprise.nom }}" data-email="{{ entreprise.email }}" data-tel="{{ entreprise.tel }}" data-desc="{{ entreprise.desc }}"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn-icon btn-rate" title="Évaluer" data-nom="{{ entreprise.nom }}"><i class="fa-solid fa-star"></i></button>
                                <button class="btn-icon btn-delete" title="Supprimer" data-nom="{{ entreprise.nom }}"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        </main>
{% endblock %}

{% block javascripts %}
    {% endblock %}