{# 1. On appelle le squelette de base #}
{% extends 'base.html.twig' %}

{# 2. On définit le titre de l'onglet #}
{% block title %}LEMS - Entreprises partenaires{% endblock %}

{# 3. CSS spécifique à la page entreprise #}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/entreprise.css">
{% endblock %}

{# 4. Contenu principal #}
{% block content %}
    <main class="container" style="width: min(1200px, 94%); margin: 26px auto 60px;">
        
        <div class="page-head" style="margin-bottom: 20px;">
            <h1 style="margin: 0 0 8px; font-size: 28px; font-weight: 900;">Entreprises partenaires</h1>
        </div>

        <section class="entreprise-section">
            
            {# THE TWIG LOOP #}
            {% for entreprise in entreprises %}
                <article class="entreprise-card">
                    {# I added a dynamic background color and the first letter of the company name to the logo! #}
                    <div class="entreprise-logo" style="background-color: {{ entreprise.couleur }};">
                        <h2 style="margin:0;">{{ entreprise.nom|slice(0, 1) }}</h2>
                    </div>
                    
                    <h3>{{ entreprise.nom }}</h3>
                    
                    <div class="avis">
                        {# Logic to display the correct number of solid/regular stars #}
                        {% for i in 1..5 %}
                            {% if i <= entreprise.avis %}
                                <i class="fa-solid fa-star"></i>
                            {% else %}
                                <i class="fa-regular fa-star" style="color: #ccc;"></i>
                            {% endif %}
                        {% endfor %}
                    </div>
                    
                    <div class="contact-info">
                        <p style="margin: 4px 0;"><i class="fa-solid fa-phone"></i> {{ entreprise.telephone }}</p>
                        <p style="margin: 4px 0;"><i class="fa-solid fa-envelope"></i> {{ entreprise.email }}</p>
                    </div>
                    
                    <p>{{ entreprise.description }}</p>
                    <p style="font-weight: bold; color: var(--primary-dark);">{{ entreprise.candidats }} élèves ont déjà postulé</p>
                    
                    <a href="/offres?entreprise={{ entreprise.slug }}" class="btn-voir">Découvrir les offres</a>
                </article>
            {% endfor %}

        </section>
    </main>
{% endblock %}
