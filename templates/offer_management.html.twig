{% extends 'base.html.twig' %}

{% block metas %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Gestion des offres - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="../assets/pages/Admin.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Gestion des offres</h1>
            <p class="page-subtitle">Créer, modifier ou supprimer des offres de stage et d'alternance.</p>
        </div>
        <button class="btn-add" type="button" id="btnCreateOffre">
            <i class="fa-solid fa-plus"></i> Nouvelle offre
        </button>
    </div>

    {# ===== BARRE DE RECHERCHE ===== #}
    <form method="get" action="/index.php" class="search-bar-wrap search-bar-wrap--2col">
        <input type="hidden" name="page" value="{{ current_page }}">
        <input type="hidden" name="p" value="1">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="search" value="{{ search|default('') }}"
                   placeholder="Rechercher par titre, entreprise…">
        </div>
        <div class="search-bar">
            <i class="fa-solid fa-filter"></i>
            <select name="type" class="select-bare" onchange="this.form.submit()">
                <option value="">Tous les types</option>
                <option value="Stage"      {% if type == 'Stage' %}selected{% endif %}>Stage</option>
                <option value="Alternance" {% if type == 'Alternance' %}selected{% endif %}>Alternance</option>
            </select>
        </div>
    </form>

    {# ===== TABLEAU ===== #}
    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Type</th>
                    <th>Niveau</th>
                    <th>Lieu</th>
                    <th>Rémunération</th>
                    <th>Date</th>
                    <th>Candidatures</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for offer in offers %}
                <tr>
                    <td><strong>{{ offer.title }}</strong></td>
                    <td>{{ offer.entreprise }}</td>
                    <td>
                        {% if offer.type == 'Stage' %}
                            <span class="tag-pill tag-stage">Stage</span>
                        {% else %}
                            <span class="tag-pill tag-alt">Alternance</span>
                        {% endif %}
                    </td>
                    <td><span class="tag-pill tag-bac">{{ offer.level }}</span></td>
                    <td><span class="tag-pill tag-lieu">{{ offer.lieu }}</span></td>
                    <td>{{ offer.remuneration }} €/mois</td>
                    <td>{{ offer.publication_date }}</td>
                    <td>{{ offer.candidatures ?? 0 }}</td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-view-offre" title="Voir"
                            data-id="{{ offer.ID_offer }}"
                            data-titre="{{ offer.title }}"
                            data-entreprise="{{ offer.entreprise }}"
                            data-type="{{ offer.type }}"
                            data-lieu="{{ offer.lieu }}"
                            data-remu="{{ offer.remuneration }}"
                            data-niveau="{{ offer.level }}"
                            data-duree="{{ offer.duration }}"
                            data-date="{{ offer.publication_date }}"
                            data-desc="{{ offer.description }}">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="btn-icon btn-edit-offre" title="Modifier"
                            data-id="{{ offer.ID_offer }}"
                            data-titre="{{ offer.title }}"
                            data-type="{{ offer.type }}"
                            data-niveau="{{ offer.level }}"
                            data-duree="{{ offer.duration }}"
                            data-remu="{{ offer.remuneration }}"
                            data-domain="{{ offer.domain }}"
                            data-lieu="{{ offer.lieu }}"
                            data-desc="{{ offer.description }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-delete-offre" title="Supprimer"
                            data-id="{{ offer.ID_offer }}"
                            data-titre="{{ offer.title }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="9">Aucune offre trouvée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ===== PAGINATION ===== #}
    <nav class="pagination" aria-label="Pagination des offres">

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="{{ current_page }}">
            <input type="hidden" name="p" value="{{ pageCourante - 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <input type="hidden" name="type" value="{{ type|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante <= 1 %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </form>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <form method="get" action="/index.php">
                        <input type="hidden" name="page" value="{{ current_page }}">
                        <input type="hidden" name="p" value="{{ p }}">
                        <input type="hidden" name="search" value="{{ search|default('') }}">
                        <input type="hidden" name="type" value="{{ type|default('') }}">
                        <button class="page-number {% if p == pageCourante %}active{% endif %}" type="submit">
                            {{ p }}
                        </button>
                    </form>
                {% endif %}
            {% endfor %}
        </div>

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="{{ current_page }}">
            <input type="hidden" name="p" value="{{ pageCourante + 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <input type="hidden" name="type" value="{{ type|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante >= totalPages %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </form>

    </nav>

</main>

{# ===== DIALOG VOIR ===== #}
<dialog class="dialog" id="dialogViewOffre">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-briefcase"></i></div>
            <div>
                <h2 id="viewOffreTitre">—</h2>
                <p class="dialog-company" id="viewOffreEntreprise">—</p>
            </div>
            <button class="dialog-close" id="btnCloseViewOffre" type="button">✕</button>
        </header>
        <div class="dialog-grid">
            <section class="dialog-box">
                <h3>Détails</h3>
                <ul>
                    <li><strong>Lieu :</strong> <span id="viewLieu"></span></li>
                    <li><strong>Type :</strong> <span id="viewType"></span></li>
                    <li><strong>Niveau :</strong> <span id="viewNiveau"></span></li>
                    <li><strong>Durée :</strong> <span id="viewDuree"></span></li>
                    <li><strong>Rémunération :</strong> <span id="viewRemu"></span> €/mois</li>
                    <li><strong>Date :</strong> <span id="viewDate"></span></li>
                </ul>
            </section>
            <section class="dialog-box">
                <h3>Description</h3>
                <p id="viewDesc"></p>
            </section>
        </div>
        <div class="dialog-actions">
            <button class="btn-secondary" id="btnCloseViewOffre2">Fermer</button>
        </div>
    </div>
</dialog>

{# ===== DIALOG CRÉER ===== #}
<dialog class="dialog dialog--sm" id="dialogCreateOffre">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-plus"></i></div>
            <div><h2>Nouvelle offre</h2><p class="dialog-company">Remplissez les informations.</p></div>
            <button class="dialog-close" id="btnCloseCreateOffre" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page={{ current_page }}">
            <input type="hidden" name="action" value="create">
            <div class="field">
                <label for="cTitle">Titre <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-briefcase"></i><input id="cTitle" name="title" type="text" placeholder="ex: Développeur Web" required></div>
            </div>
            <div class="field-group">
                <div class="field">
                    <label for="cType">Type <span class="required">*</span></label>
                    <div class="input">
                        <i class="fa-solid fa-tag"></i>
                        <select id="cType" name="type" class="select-bare" required>
                            <option value="">Sélectionner…</option>
                            <option value="Stage">Stage</option>
                            <option value="Alternance">Alternance</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="cLevel">Niveau <span class="required">*</span></label>
                    <div class="input">
                        <i class="fa-solid fa-signal"></i>
                        <select id="cLevel" name="level" class="select-bare" required>
                            <option value="">Sélectionner…</option>
                            <option value="Bac+2/3">Bac+2/3</option>
                            <option value="Bac+3">Bac+3</option>
                            <option value="Bac+4/5">Bac+4/5</option>
                            <option value="Bac+5">Bac+5</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="field">
                <label for="cDomain">Domaine <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-folder"></i><input id="cDomain" name="domain" type="text" placeholder="ex: Développement" required></div>
            </div>
            <div class="field-group">
                <div class="field">
                    <label for="cDuration">Durée <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-clock"></i><input id="cDuration" name="duration" type="text" placeholder="ex: 6 mois" required></div>
                </div>
                <div class="field">
                    <label for="cRemu">Rémunération (€) <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-euro-sign"></i><input id="cRemu" name="remuneration" type="number" placeholder="ex: 900" required></div>
                </div>
            </div>
            <div class="field">
                <label for="cCity">Ville <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-location-dot"></i><input id="cCity" name="city" type="text" placeholder="ex: Lyon" required></div>
            </div>
            <div class="field">
                <label for="cCompany">Entreprise <span class="required">*</span></label>
                <div class="input">
                    <i class="fa-solid fa-building"></i>
                    <select id="cCompany" name="id_company" class="select-bare" required>
                        <option value="">Sélectionner…</option>
                        {% for company in companies %}
                            <option value="{{ company.ID }}">{{ company.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="field">
                <label for="cDate">Date de publication <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-calendar"></i><input id="cDate" name="publication_date" type="date" required></div>
            </div>
            <div class="field">
                <label for="cDesc">Description <span class="required">*</span></label>
                <textarea id="cDesc" name="description" rows="3" placeholder="Description de l'offre…" required></textarea>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelCreateOffre">Annuler</button>
                <button class="btn-voir" type="submit">Créer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG MODIFIER ===== #}
<dialog class="dialog dialog--sm" id="dialogEditOffre">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-pen"></i></div>
            <div><h2>Modifier l'offre</h2><p class="dialog-company" id="editOffreSubtitle">—</p></div>
            <button class="dialog-close" id="btnCloseEditOffre" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page={{ current_page }}">
            <input type="hidden" name="action" value="update">
            <input type="hidden" name="id" id="eOffreId">
            <div class="field">
                <label for="eTitle">Titre <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-briefcase"></i><input id="eTitle" name="title" type="text" required></div>
            </div>
            <div class="field-group">
                <div class="field">
                    <label for="eType">Type <span class="required">*</span></label>
                    <div class="input">
                        <i class="fa-solid fa-tag"></i>
                        <select id="eType" name="type" class="select-bare" required>
                            <option value="">Sélectionner…</option>
                            <option value="Stage">Stage</option>
                            <option value="Alternance">Alternance</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="eLevel">Niveau <span class="required">*</span></label>
                    <div class="input">
                        <i class="fa-solid fa-signal"></i>
                        <select id="eLevel" name="level" class="select-bare" required>
                            <option value="">Sélectionner…</option>
                            <option value="Bac+2/3">Bac+2/3</option>
                            <option value="Bac+3">Bac+3</option>
                            <option value="Bac+4/5">Bac+4/5</option>
                            <option value="Bac+5">Bac+5</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="field">
                <label for="eDomain">Domaine <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-folder"></i><input id="eDomain" name="domain" type="text" required></div>
            </div>
            <div class="field-group">
                <div class="field">
                    <label for="eDuration">Durée <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-clock"></i><input id="eDuration" name="duration" type="text" required></div>
                </div>
                <div class="field">
                    <label for="eRemu">Rémunération (€) <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-euro-sign"></i><input id="eRemu" name="remuneration" type="number" required></div>
                </div>
            </div>
            <div class="field">
                <label for="eCity">Ville <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-location-dot"></i><input id="eCity" name="city" type="text" required></div>
            </div>
            <div class="field">
                <label for="eDesc">Description <span class="required">*</span></label>
                <textarea id="eDesc" name="description" rows="3" required></textarea>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelEditOffre">Annuler</button>
                <button class="btn-voir" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG SUPPRIMER ===== #}
<dialog class="dialog dialog--sm" id="dialogDeleteOffre">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--danger"><i class="fa-solid fa-trash"></i></div>
            <div><h2>Supprimer l'offre</h2><p class="dialog-company" id="deleteOffreTitre">—</p></div>
            <button class="dialog-close" id="btnCloseDeleteOffre" type="button">✕</button>
        </header>
        <div class="dialog-confirm-body">
            <p>Cette action est <strong>irréversible</strong>. L'offre et toutes ses candidatures seront supprimées.</p>
        </div>
        <form method="post" action="/index.php?page={{ current_page }}">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="id" id="dOffreId">
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelDeleteOffre">Annuler</button>
                <button class="btn-danger" type="submit">Supprimer</button>
            </div>
        </form>
    </div>
</dialog>

{% endblock %}

{% block javascripts %}
<script>
    function openDialog(id) { document.getElementById(id).showModal(); }
    function closeDialog(id) { document.getElementById(id).close(); }

    ['dialogViewOffre', 'dialogCreateOffre', 'dialogEditOffre', 'dialogDeleteOffre'].forEach(id => {
        const d = document.getElementById(id);
        d.addEventListener('click', e => {
            const r = d.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close();
        });
    });

    document.getElementById('btnCreateOffre').onclick       = () => openDialog('dialogCreateOffre');
    document.getElementById('btnCloseCreateOffre').onclick  = () => closeDialog('dialogCreateOffre');
    document.getElementById('btnCancelCreateOffre').onclick = () => closeDialog('dialogCreateOffre');

    document.querySelectorAll('.btn-view-offre').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('viewOffreTitre').textContent      = btn.dataset.titre;
            document.getElementById('viewOffreEntreprise').textContent = btn.dataset.entreprise;
            document.getElementById('viewLieu').textContent            = btn.dataset.lieu;
            document.getElementById('viewType').textContent            = btn.dataset.type;
            document.getElementById('viewNiveau').textContent          = btn.dataset.niveau;
            document.getElementById('viewDuree').textContent           = btn.dataset.duree;
            document.getElementById('viewRemu').textContent            = btn.dataset.remu;
            document.getElementById('viewDate').textContent            = btn.dataset.date;
            document.getElementById('viewDesc').textContent            = btn.dataset.desc;
            openDialog('dialogViewOffre');
        };
    });
    document.getElementById('btnCloseViewOffre').onclick  = () => closeDialog('dialogViewOffre');
    document.getElementById('btnCloseViewOffre2').onclick = () => closeDialog('dialogViewOffre');

    document.querySelectorAll('.btn-edit-offre').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('editOffreSubtitle').textContent = btn.dataset.titre;
            document.getElementById('eOffreId').value  = btn.dataset.id;
            document.getElementById('eTitle').value    = btn.dataset.titre  || '';
            document.getElementById('eDomain').value   = btn.dataset.domain || '';
            document.getElementById('eDuration').value = btn.dataset.duree  || '';
            document.getElementById('eRemu').value     = btn.dataset.remu   || '';
            document.getElementById('eCity').value     = btn.dataset.lieu   || '';
            document.getElementById('eDesc').value     = btn.dataset.desc   || '';
            const eType = document.getElementById('eType');
            for (let o of eType.options) o.selected = o.value === btn.dataset.type;
            const eLevel = document.getElementById('eLevel');
            for (let o of eLevel.options) o.selected = o.value === btn.dataset.niveau;
            openDialog('dialogEditOffre');
        };
    });
    document.getElementById('btnCloseEditOffre').onclick  = () => closeDialog('dialogEditOffre');
    document.getElementById('btnCancelEditOffre').onclick = () => closeDialog('dialogEditOffre');

    document.querySelectorAll('.btn-delete-offre').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('deleteOffreTitre').textContent = btn.dataset.titre;
            document.getElementById('dOffreId').value               = btn.dataset.id;
            openDialog('dialogDeleteOffre');
        };
    });
    document.getElementById('btnCloseDeleteOffre').onclick  = () => closeDialog('dialogDeleteOffre');
    document.getElementById('btnCancelDeleteOffre').onclick = () => closeDialog('dialogDeleteOffre');
</script>
{% endblock %}
