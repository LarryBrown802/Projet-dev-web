{% extends 'base.html.twig' %}

{% block title %}Offer{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/pilot.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Gestion des offres</h1>
            <p class="page-subtitle">Créer, modifier ou supprimer des offres de stage et d'alternance.</p>
        </div>
        <button class="btn-add" type="button" id="btnCreateOffre">
            <i class="fa-solid fa-plus"></i> Nouvelle offre
        </button>
    </div>

    <!-- Barre recherche + filtre -->
    <div class="search-bar-wrap" style="display:grid;grid-template-columns:1fr 200px;gap:12px">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" placeholder="Rechercher une offre par titre, entreprise…" aria-label="Rechercher une offre" />
        </div>
        <div class="search-bar">
            <i class="fa-solid fa-filter"></i>
            <select style="border:none;outline:none;width:100%;background:transparent;font-weight:800;cursor:pointer">
                <option value="">Tous les types</option>
                <option value="stage">Stage</option>
                <option value="alternance">Alternance</option>
            </select>
        </div>
    </div>

    <!-- Tableau -->
    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Type</th>
                    <th>Lieu</th>
                    <th>Rémunération</th>
                    <th>Candidatures</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for offer in offers %}
                <tr>
                    <td><strong>{{ offer.poste }}</strong></td>
                    <td>{{ offer.entreprise }}</td>
                    <td>
                        <span class="badge {{ offer.type == 'Stage' ? 'badge--wait' : 'badge--ok' }}">
                            {{ offer.type }}
                        </span>
                    </td>
                    <td>{{ offer.lieu }}</td>
                    <td>{{ offer.remuneration }}</td>
                    <td>{{ offer.candidatures }}</td>
                    <td>{{ offer.date }}</td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-view" title="Voir"
                            data-titre="{{ offer.poste }}"
                            data-entreprise="{{ offer.entreprise }}"
                            data-type="{{ offer.type }}"
                            data-lieu="{{ offer.lieu }}"
                            data-remu="{{ offer.remuneration }}"
                            data-niveau="{{ offer.niveau }}"
                            data-duree="{{ offer.duree }}"
                            data-desc="{{ offer.description }}"
                            data-missions="{{ offer.missions|join(';') }}"
                            data-date="{{ offer.date }}">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="btn-icon btn-edit-offre" title="Modifier"
                            data-titre="{{ offer.poste }}"
                            data-entreprise="{{ offer.entreprise }}"
                            data-type="{{ offer.type }}"
                            data-lieu="{{ offer.lieu }}"
                            data-remu="{{ offer.remuneration }}"
                            data-niveau="{{ offer.niveau }}"
                            data-duree="{{ offer.duree }}"
                            data-desc="{{ offer.description }}"
                            data-missions="{{ offer.missions|join(';') }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-delete-offre" title="Supprimer"
                            data-titre="{{ offer.poste }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="8">Aucune offre trouvée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav class="pagination" aria-label="Pagination des offres">
        <button class="page-arrow" type="button"
            {% if pageCourante <= 1 %}disabled{% endif %}
            onclick="window.location='?page=offer_management&p={{ pageCourante - 1 }}&search={{ search|default('') }}&location={{ location|default('') }}'">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <button class="page-number {% if p == pageCourante %}active{% endif %}"
                        type="button"
                        onclick="window.location='?page=offer_management&p={{ p }}&search={{ search|default('') }}&location={{ location|default('') }}'">
                        {{ p }}
                    </button>
                {% endif %}
            {% endfor %}
        </div>

        <button class="page-arrow" type="button"
            {% if pageCourante >= totalPages %}disabled{% endif %}
            onclick="window.location='?page=offer_management&p={{ pageCourante + 1 }}&search={{ search|default('') }}&location={{ location|default('') }}'">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </nav>

  </main>
{% endblock %}