{% extends 'base.html.twig' %}

{% block title %}{{ company.nom }} - Détails{% endblock %}

{% block content %}
    <div style="width: 100%; height: 250px; background-image: url('{{ company.logo }}'); background-size: cover; background-position: center;"></div>

    <main class="container" style="margin-top: -50px; position: relative; z-index: 10;">
        
        <div style="background: var(--card); padding: 40px; border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--border);">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
                <div>
                    <h1 style="margin-top: 0; font-size: 32px;">{{ company.nom }}</h1>
                    
                    <div class="avis" style="color: #c8a000; margin-bottom: 20px; font-size: 18px;">
                        {% for i in 1..5 %}
                            {% if i <= company.note %}
                                <i class="fa-solid fa-star"></i>
                            {% else %}
                                <i class="fa-regular fa-star"></i>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <div style="background: var(--bg); padding: 20px; border-radius: 8px; border: 1px solid var(--border);">
                    <h3 style="margin-top: 0; font-size: 16px;">Contact</h3>
                    <p style="margin: 5px 0;"><i class="fa-solid fa-phone" style="color: var(--primary); width: 25px;"></i> {{ company.tel }}</p>
                    <p style="margin: 5px 0;"><i class="fa-solid fa-envelope" style="color: var(--primary); width: 25px;"></i> {{ company.email }}</p>
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 30px 0;">

            <h2>À propos de nous</h2>
            <p style="line-height: 1.8; color: var(--text); font-size: 16px;">
                {{ company.desc }}
            </p>
            <p style="line-height: 1.8; color: var(--text); font-size: 16px;">
                Chez {{ company.nom }}, nous nous engageons à offrir le meilleur environnement de travail pour nos collaborateurs. Rejoignez une équipe dynamique et participez à des projets innovants !
            </p>

            <div style="margin-top: 40px; text-align: center;">
                <h3 style="margin-bottom: 20px;">Cette entreprise recrute !</h3>
                <p style="margin-bottom: 20px; font-size: 18px;"><strong>{{ company.offres_count }}</strong> offres sont actuellement disponibles.</p>
                <a href="/index.php?page=offers&search={{ company.nom }}" class="btn-voir" style="text-decoration: none; padding: 15px 30px; font-size: 16px;">Voir les offres de {{ company.nom }}</a>
            </div>

        </div>
    </main>
{% endblock %}