{% extends 'base.html.twig' %}

{% block title %}{{ company.name }} - Détails{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/entreprise.css">
{% endblock %}

{% block content %}

    {# ===== BANNIÈRE ===== #}
    <div style="width: 100%; height: 200px; background: linear-gradient(135deg, var(--primary), var(--primary-dark, #3a0ca3)); display: flex; align-items: center; justify-content: center;">
        <div style="background: var(--card); width: 80px; height: 80px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 36px; color: var(--primary);">
            <i class="fa-solid fa-building"></i>
        </div>
    </div>

    <main class="container" style="margin-top: -40px; position: relative; z-index: 10;">

        <div style="background: var(--card); padding: 40px; border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--border);">

            {# ===== EN-TÊTE ===== #}
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
                <div>
                    <h1 style="margin-top: 0; font-size: 32px;">{{ company.name }}</h1>

                    <div class="avis" style="color: #c8a000; margin-bottom: 20px; font-size: 18px;">
                        {% set note = company.average_mark ?? 0 %}
                        {% for i in 1..5 %}
                            {% if i <= note %}
                                <i class="fa-solid fa-star"></i>
                            {% else %}
                                <i class="fa-regular fa-star"></i>
                            {% endif %}
                        {% endfor %}
                        <span style="font-size: 14px; color: var(--text); margin-left: 8px;">{{ note }}/5</span>
                    </div>
                </div>

                {# ===== CONTACT ===== #}
                <div style="background: var(--bg); padding: 20px; border-radius: 8px; border: 1px solid var(--border); min-width: 220px;">
                    <h3 style="margin-top: 0; font-size: 16px;">Contact</h3>
                    <p style="margin: 8px 0;">
                        <i class="fa-solid fa-phone" style="color: var(--primary); width: 25px;"></i>
                        {{ company.number ?? '—' }}
                    </p>
                    <p style="margin: 8px 0;">
                        <i class="fa-solid fa-envelope" style="color: var(--primary); width: 25px;"></i>
                        {{ company.email ?? '—' }}
                    </p>
                </div>
            </div>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 30px 0;">

            {# ===== DESCRIPTION ===== #}
            <h2>À propos de nous</h2>
            <p style="line-height: 1.8; color: var(--text); font-size: 16px;">
                {{ company.description ?? 'Aucune description disponible.' }}
            </p>
            <p style="line-height: 1.8; color: var(--text); font-size: 16px;">
                Chez {{ company.name }}, nous nous engageons à offrir le meilleur environnement de travail pour nos collaborateurs.
                Rejoignez une équipe dynamique et participez à des projets innovants !
            </p>

            <hr style="border: none; border-top: 1px solid var(--border); margin: 30px 0;">

            {# ===== OFFRES ===== #}
            <div style="margin-top: 20px; text-align: center;">
                <h3 style="margin-bottom: 20px;">Cette entreprise recrute !</h3>
                <p style="margin-bottom: 20px; font-size: 18px;">
                    <strong>{{ company.offres_count ?? 0 }}</strong> offres sont actuellement disponibles.
                </p>
                <a href="/index.php?page=offers&search={{ company.name }}"
                   class="btn-voir"
                   style="text-decoration: none; padding: 15px 30px; font-size: 16px;">
                    Voir les offres de {{ company.name }}
                </a>
            </div>

        </div>

        {# ===== RETOUR ===== #}
        <div style="margin-top: 20px;">
            <a href="/index.php?page=company" style="color: var(--primary); text-decoration: none; font-size: 14px;">
                <i class="fa-solid fa-arrow-left"></i> Retour aux entreprises
            </a>
        </div>

    </main>
{% endblock %}
