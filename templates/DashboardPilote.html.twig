{# 1. On appelle le squelette de base #}
{% extends 'base.html.twig' %}

{# 2. On définit le titre de l'onglet #}
{% block title %}LEMS - Tableau de bord Pilote{% endblock %}

{# 3. CSS spécifique au panel pilote #}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Pilote.css">
{% endblock %}

{# 4. Contenu principal #}
{% block content %}
    <main class="container">

        <div class="page-head">
            <div>
                <h1>Tableau de bord</h1>
                <p class="page-subtitle">Bienvenue, <strong>{{ pilote.nom }}</strong> — Pilote de promotion {{ pilote.promotion }}</p>
            </div>
            <div class="page-meta">
                <div class="meta-card">
                    <span class="meta-label">Promotion</span>
                    <span class="meta-value" style="font-size: 16px;">{{ pilote.promotion }}</span>
                </div>
                <div class="meta-card">
                    <span class="meta-label">Étudiants</span>
                    <span class="meta-value">{{ pilote.nb_etudiants }}</span>
                </div>
            </div>
        </div>

        <section class="kpi-grid" aria-label="Indicateurs clés">
            <article class="kpi-card">
                <div class="kpi-icon kpi-blue"><i class="fa-solid fa-file-circle-check"></i></div>
                <div>
                    <p class="kpi-label">Candidatures totales</p>
                    <p class="kpi-value">{{ kpis.candidatures_totales }}</p>
                </div>
            </article>
            <article class="kpi-card">
                <div class="kpi-icon kpi-green"><i class="fa-solid fa-user-graduate"></i></div>
                <div>
                    <p class="kpi-label">Étudiants ayant postulé</p>
                    <p class="kpi-value">{{ kpis.etudiants_postule }}</p>
                </div>
            </article>
            <article class="kpi-card">
                <div class="kpi-icon kpi-yellow"><i class="fa-solid fa-building"></i></div>
                <div>
                    <p class="kpi-label">Entreprises partenaires</p>
                    <p class="kpi-value">{{ kpis.entreprises }}</p>
                </div>
            </article>
            <article class="kpi-card">
                <div class="kpi-icon kpi-purple"><i class="fa-solid fa-briefcase"></i></div>
                <div>
                    <p class="kpi-label">Offres disponibles</p>
                    <p class="kpi-value">{{ kpis.offres_dispos }}</p>
                </div>
            </article>
        </section>

        <section class="dash-section">
            <h2 class="section-title-dash">Accès rapides</h2>
            <div class="shortcut-grid">
                <a href="/pilote/entreprises" class="shortcut-card">
                    <div class="shortcut-icon"><i class="fa-solid fa-building"></i></div>
                    <span>Gérer les entreprises</span>
                </a>
                <a href="/pilote/offres" class="shortcut-card">
                    <div class="shortcut-icon"><i class="fa-solid fa-briefcase"></i></div>
                    <span>Gérer les offres</span>
                </a>
                <a href="/pilote/etudiants" class="shortcut-card">
                    <div class="shortcut-icon"><i class="fa-solid fa-user-graduate"></i></div>
                    <span>Gérer les étudiants</span>
                </a>
            </div>
        </section>

        <section class="dash-section">
            <div class="section-head-row">
                <h2 class="section-title-dash">Dernières candidatures de ma promotion</h2>
                <a href="/pilote/etudiants" class="link-see-all">Voir tout <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Étudiant</th>
                            <th>Offre</th>
                            <th>Entreprise</th>
                            <th>Date</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# THE DYNAMIC LOOP #}
                        {% for candidature in candidatures %}
                            <tr>
                                <td><strong>{{ candidature.etudiant }}</strong></td>
                                <td>{{ candidature.offre }}</td>
                                <td>{{ candidature.entreprise }}</td>
                                <td>{{ candidature.date }}</td>
                                <td><span class="badge {{ candidature.badge }}">{{ candidature.statut }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

    </main>
{% endblock %}