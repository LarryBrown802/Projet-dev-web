{% extends 'base.html.twig' %}

{% block title %}Ma Wishlist - LEMS{% endblock %}

{% block stylesheets %}
    {# On réutilise le CSS des offres car on affiche exactement les mêmes cartes ! #}
    <link rel="stylesheet" href="/assets/pages/offre.css">
    {# Si tu avais un CSS spécifique, tu peux le laisser #}
    <link rel="stylesheet" href="/assets/pages/wishlist.css">
{% endblock %}

{% block content %}
<main class="container">
    <div class="page-head" style="text-align: center; margin-bottom: 40px;">
        <h1 style="font-size: 32px; color: var(--primary);">Ma Wishlist</h1>
        <p class="page-subtitle">Retrouvez ici toutes les offres que vous avez sauvegardées pour postuler plus tard.</p>
    </div>

    {# La grille qui contient toutes les cartes #}
    <section class="offres" aria-label="Liste de mes favoris" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
        
        {% for offer in offers %}
            <article class="offre-card">
                <div class="offre-top">
                    <div class="offre-logo">
                        <i class="fa-solid {{ offer.icon }}"></i>
                    </div>

                    <div class="offre-title">
                        <h2 class="offre-poste">{{ offer.poste }}</h2>
                        <p class="offre-entreprise">{{ offer.entreprise }}</p>
                    </div>

                    {# Le bouton favori (qui sera TOUJOURS "coché" par défaut sur cette page puisqu'on est dans la wishlist !) #}
                    <label class="ui-bookmark" title="Retirer des favoris">
                        <input type="checkbox" aria-label="Retirer des favoris" data-offer-id="{{ offer.id }}" class="bookmark-checkbox" checked />
                        <div class="bookmark" aria-hidden="true">
                            <svg viewBox="0 0 32 32">
                                <path d="M27 4v27a1 1 0 0 1-1.625.781L16 24.281l-9.375 7.5A1 1 0 0 1 5 31V4a4 4 0 0 1 4-4h14a4 4 0 0 1 4 4z"></path>
                            </svg>
                        </div>
                    </label>
                </div>

                <div class="offre-tags">
                    <span class="tag tag-lieu"><i class="fa-solid fa-location-dot"></i> {{ offer.lieu }}</span>
                    <span class="tag tag-type"><i class="fa-solid fa-briefcase"></i> {{ offer.type }}</span>
                    <span class="tag tag-nv"><i class="fa-solid fa-signal"></i> {{ offer.niveau }}</span>
                    <span class="tag tag-remu"><i class="fa-solid fa-euro-sign"></i> {{ offer.remuneration }}</span>
                </div>

                <div class="offre-desc">
                    <strong>Description</strong>
                    <p class="truncate-3">{{ offer.description }}</p>
                </div>

                <button
                    class="btn-voir btn-full open-dialog"
                    type="button"
                    data-poste="{{ offer.poste }}"
                    data-entreprise="{{ offer.entreprise }}"
                    data-lieu="{{ offer.lieu }}"
                    data-type="{{ offer.type }}"
                    data-niveau="{{ offer.niveau }}"
                    data-duree="{{ offer.duree }}"
                    data-remu="{{ offer.remuneration }}"
                    data-entreprisedesc="{{ offer.entrepriseDesc }}"
                    data-missions="{{ offer.missions|join(';') }}"
                    data-icon="{{ offer.icon }}"
                >
                    Voir plus
                </button>
            </article>
        {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 50px; background: var(--card); border-radius: 14px; border: 1px dashed var(--border);">
                <i class="fa-regular fa-bookmark" style="font-size: 48px; color: var(--muted); margin-bottom: 20px;"></i>
                <h3 style="margin-bottom: 10px;">Votre wishlist est vide</h3>
                <p style="color: var(--muted); margin-bottom: 20px;">Parcourez les offres et cliquez sur le marque-page pour les sauvegarder ici.</p>
                <a href="/index.php?page=offers" class="btn-primary" style="text-decoration: none; display: inline-block;">Découvrir les offres</a>
            </div>
        {% endfor %}
    </section>
</main>

<dialog class="dialog" id="offreDialog" aria-labelledby="dialogTitle">
    <form method="dialog" class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo" id="dialogIcon">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <div>
                <h2 id="dialogTitle">Titre du poste</h2>
                <p class="dialog-company" id="dialogCompany">Entreprise</p>
            </div>
            <button class="dialog-close" value="cancel" aria-label="Fermer">✕</button>
        </header>

        <div class="dialog-grid">
            <section class="dialog-box">
                <h3>Détails</h3>
                <ul>
                    <li><strong>Lieu :</strong> <span id="dialogLieu"></span></li>
                    <li><strong>Type :</strong> <span id="dialogType"></span></li>
                    <li><strong>Niveau :</strong> <span id="dialogNiveau"></span></li>
                    <li><strong>Durée :</strong> <span id="dialogDuree"></span></li>
                    <li><strong>Rémunération :</strong> <span id="dialogRemu"></span></li>
                </ul>
            </section>

            <section class="dialog-box dialog-full">
                <h3>À propos de l'entreprise</h3>
                <p id="dialogEntrepriseDesc"></p>
            </section>
        </div>

        <footer class="dialog-actions">
            <button class="btn-voir btn-full" type="button">Postuler</button>
        </footer>
    </form>
</dialog>
{% endblock %}

{% block javascripts %}
    <script>
        // 1. LOGIQUE DU MODAL "VOIR PLUS"
        const dialog = document.getElementById('offreDialog');
        const openBtns = document.querySelectorAll('.open-dialog');
        
        openBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('dialogTitle').textContent = btn.dataset.poste;
                document.getElementById('dialogCompany').textContent = btn.dataset.entreprise;
                document.getElementById('dialogLieu').textContent = btn.dataset.lieu;
                document.getElementById('dialogType').textContent = btn.dataset.type;
                document.getElementById('dialogNiveau').textContent = btn.dataset.niveau;
                document.getElementById('dialogDuree').textContent = btn.dataset.duree;
                document.getElementById('dialogRemu').textContent = btn.dataset.remu;
                document.getElementById('dialogEntrepriseDesc').textContent = btn.dataset.entreprisedesc;
                document.getElementById('dialogIcon').innerHTML = `<i class="fa-solid ${btn.dataset.icon}"></i>`;
                
                dialog.showModal();
            });
        });

        // Bouton Postuler du Modal
        const btnApplyAction = document.querySelector('.dialog-actions .btn-voir');
        if (btnApplyAction) {
            btnApplyAction.addEventListener('click', () => {
                const poste = encodeURIComponent(document.getElementById('dialogTitle').textContent);
                const entreprise = encodeURIComponent(document.getElementById('dialogCompany').textContent);
                window.location.href = `/index.php?page=apply&poste=${poste}&entreprise=${entreprise}`;
            });
        }

        // Fermer le modal au clic à l'extérieur
        dialog.addEventListener('click', e => {
            const r = dialog.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
                dialog.close();
            }
        });

        // 2. LOGIQUE DE LA WISHLIST (Retirer des favoris)
        document.querySelectorAll('.bookmark-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', async function() {
                const offerId = this.dataset.offerId;
                if (!offerId) return;

                try {
                    const response = await fetch('/index.php?page=toggle_wishlist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ offer_id: offerId })
                    });
                    
                    const result = await response.json();
                    
                    if (result.success && result.added === false) {
                        // Si le retrait a réussi en BDD, on fait disparaître la carte de l'écran avec une animation !
                        const card = this.closest('.offre-card');
                        card.style.transition = "opacity 0.3s, transform 0.3s";
                        card.style.opacity = "0";
                        card.style.transform = "scale(0.9)";
                        setTimeout(() => {
                            card.remove();
                            // S'il n'y a plus de cartes, on pourrait recharger la page pour afficher le message "Wishlist vide"
                            if(document.querySelectorAll('.offre-card').length === 0) {
                                window.location.reload();
                            }
                        }, 300);
                    }
                } catch (e) {
                    this.checked = true; // On remet le signet si erreur
                    console.error("Erreur d'enregistrement", e);
                }
            });
        });
    </script>
{% endblock %}