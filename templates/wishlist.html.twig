{# 1. On appelle le squelette de base #}
{% extends 'base.html.twig' %}

{# 2. On définit le titre de l'onglet #}
{% block title %}LEMS - Ma Wishlist{% endblock %}

{# 3. CSS spécifique à cette page #}
{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/wishlist.css">
{% endblock %}

{# 4. Contenu principal #}
{% block content %}
    <main class="container">
        <header class="page-head">
            <div class="page-title">
                <h1>Ma wishlist</h1>
                <p class="page-subtitle">Retrouve toutes les offres que tu as ajoutées en favoris.</p>
            </div>

            <div class="page-meta" aria-label="Statistiques wishlist">
                <div class="meta-card">
                    <span class="meta-label">Favoris</span>
                    <span class="meta-value">{{ favoris|length }}</span>
                </div>
                <div class="meta-card">
                    <span class="meta-label">Nouveaux</span>
                    <span class="meta-value">0</span>
                </div>
            </div>
        </header>

        <section class="results-bar" aria-label="Recherche et tri">
            <div class="results-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" placeholder="Rechercher dans mes favoris…" aria-label="Rechercher dans la wishlist" />
            </div>

            <div class="results-sort">
                <label class="sr-only" for="sort">Trier</label>
                <i class="fa-solid fa-arrow-up-wide-short"></i>
                <select id="sort">
                    <option value="recent">Plus récent</option>
                    <option value="pertinence">Pertinence</option>
                    <option value="remu">Rémunération</option>
                    <option value="az">A → Z</option>
                </select>
            </div>
        </section>

        <section class="wishlist-grid" aria-label="Liste des favoris">

            {% if favoris is empty %}
                <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 40px; background: var(--card); border-radius: var(--radius); border: 1px solid var(--border);">
                    <i class="fa-regular fa-heart" style="font-size: 40px; color: var(--muted); margin-bottom: 10px;"></i>
                    <h3>Votre wishlist est vide</h3>
                    <p>Découvrez nos <a href="/offres" style="color: var(--primary-dark);">offres</a> et ajoutez-les en favoris !</p>
                </div>
            {% else %}
                {% for offre in favoris %}
                    <article class="offre-card">
                        <div class="offre-top">
                            <div class="offre-logo">
                                <i class="fa-solid {{ offre.icon }}"></i>
                            </div>
                            <div class="offre-title">
                                <h2 class="offre-poste">{{ offre.titre }}</h2>
                                <p class="offre-entreprise">{{ offre.entreprise }}</p>
                            </div>

                            <label class="ui-bookmark">
                                <input type="checkbox" checked>
                                <div class="bookmark">
                                    <svg viewBox="0 0 32 32">
                                        <path d="M27 4v27a1 1 0 0 1-1.625.781L16 24.281l-9.375 7.5A1 1 0 0 1 5 31V4a4 4 0 0 1 4-4h14a4 4 0 0 1 4 4z"></path>
                                    </svg>
                                </div>
                            </label>
                        </div>

                        <div class="offre-tags">
                            <span class="tag tag-lieu"><i class="fa-solid fa-location-dot"></i> {{ offre.lieu }}</span>
                            <span class="tag tag-type"><i class="fa-solid fa-briefcase"></i> {{ offre.type }}</span>
                            <span class="tag tag-nv"><i class="fa-solid fa-signal"></i> {{ offre.niveau }}</span>
                            <span class="tag tag-remu"><i class="fa-solid fa-euro-sign"></i> {{ offre.remu }}</span>
                        </div>

                        <div class="offre-desc">
                            <strong>Description</strong>
                            <p class="truncate-3">{{ offre.description }}</p>
                        </div>

                        <div class="card-actions">
                            <button class="btn-secondary" type="button">Retirer</button>
                            <button class="btn-voir" type="button">Voir plus</button>
                        </div>
                    </article>
                {% endfor %}
            {% endif %}

            <nav class="pagination" aria-label="Pagination des favoris">
                <button class="page-arrow" type="button" aria-label="Page précédente" disabled>
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div class="page-numbers" aria-live="polite" aria-label="Numéros de pages">
                    <button class="page-number active" type="button" aria-current="page">1</button>
                    <button class="page-number" type="button">2</button>
                </div>
                <button class="page-arrow" type="button" aria-label="Page suivante">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </nav>

        </section>
    </main>
{% endblock %}