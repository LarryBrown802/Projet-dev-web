{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/entreprise.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head" style="text-align: center; margin: 40px 0;">
        <h1>Nos Entreprises Partenaires</h1>
        <p class="page-subtitle">Découvrez les entreprises qui recrutent actuellement.</p>
    </div>

    <div id="company-list-container">
        <section class="entreprise-section">

            {% for company in companies %}
                <article class="entreprise-card">
                    <div style="padding: 20px;">
                        <h3 style="margin-top: 0;">{{ company.name }}</h3>

                        <div class="avis" style="color: #c8a000; margin-bottom: 15px;">
                            {% set note = company.average_mark ?? 0 %}
                            {% for i in 1..5 %}
                                {% if i <= note %}
                                    <i class="fa-solid fa-star"></i>
                                {% else %}
                                    <i class="fa-regular fa-star"></i>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="contact-info" style="font-size: 14px; margin-bottom: 15px;">
                            <p style="margin: 5px 0;">
                                <i class="fa-solid fa-phone" style="width: 20px;"></i>
                                {{ company.number ?? '—' }}
                            </p>
                            <p style="margin: 5px 0;">
                                <i class="fa-solid fa-envelope" style="width: 20px;"></i>
                                {{ company.email ?? '—' }}
                            </p>
                        </div>

                        <p style="font-size: 14px; line-height: 1.5; color: var(--text); height: 65px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                            {{ company.description ?? 'Aucune description disponible.' }}
                        </p>

                        <p style="font-size: 13px; font-weight: bold; color: var(--primary); margin-top: 10px;">
                            {{ company.stagiaires ?? 0 }} stagiaires ayant postulé
                        </p>

                        <a href="/index.php?page=company_detail&id={{ company.ID }}"
                           class="btn-voir"
                           style="display: block; text-align: center; text-decoration: none; margin-top: 15px;">
                            Découvrir
                        </a>
                    </div>
                </article>
            {% else %}
                <p style="grid-column: 1 / -1; text-align: center;">Aucune entreprise trouvée.</p>
            {% endfor %}

        </section>

        {# ===== PAGINATION ===== #}
        <nav class="pagination" aria-label="Pagination des entreprises" style="margin-top: 40px; justify-content: center;">

            {% if pageCourante > 1 %}
                <a href="?page=company&p={{ pageCourante - 1 }}" class="page-arrow" aria-label="Page précédente">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            {% else %}
                <button class="page-arrow" type="button" disabled>
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            {% endif %}

            <div class="page-numbers">
                {% for i in 1..totalPages %}
                    <a href="?page=company&p={{ i }}"
                       class="page-number {% if i == pageCourante %}active{% endif %}">
                        {{ i }}
                    </a>
                {% endfor %}
            </div>

            {% if pageCourante < totalPages %}
                <a href="?page=company&p={{ pageCourante + 1 }}" class="page-arrow" aria-label="Page suivante">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            {% else %}
                <button class="page-arrow" type="button" disabled>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            {% endif %}

        </nav>
    </div>

</main>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('click', function(e) {
        const paginationLink = e.target.closest('.pagination a');
        if (!paginationLink) return;

        e.preventDefault();
        const url = paginationLink.href;
        const container = document.getElementById('company-list-container');

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.getElementById('company-list-container').innerHTML;
                container.innerHTML = newContent;
                window.history.pushState({path: url}, '', url);
                window.scrollTo({ top: container.offsetTop - 50, behavior: 'smooth' });
            })
            .catch(() => { window.location.href = url; });
    });
</script>
{% endblock %}
