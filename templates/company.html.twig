{% extends 'base.html.twig' %}

{% block title %}Entreprises - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/entreprise.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head page-head--centered">
        <h1>Nos Entreprises Partenaires</h1>
        <p class="page-subtitle">Découvrez les entreprises qui recrutent actuellement.</p>
    </div>

    <div id="company-list-container">
        <div class="entreprise-section">

            {% for company in companies %}
                <article class="entreprise-card">
                    <div class="entreprise-card__body">
                        <h2 class="entreprise-card__name">{{ company.name }}</h2>

                        <div class="avis">
                            {% set note = company.average_mark ?? 0 %}
                            {% for i in 1..5 %}
                                {% if i <= note %}
                                    <i class="fa-solid fa-star"></i>
                                {% else %}
                                    <i class="fa-regular fa-star"></i>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="contact-info">
                            <p><i class="fa-solid fa-phone"></i>{{ company.number ?? '—' }}</p>
                            <p><i class="fa-solid fa-envelope"></i>{{ company.email ?? '—' }}</p>
                        </div>

                        <p class="entreprise-card__description">
                            {{ company.description ?? 'Aucune description disponible.' }}
                        </p>

                        <p class="entreprise-card__stagiaires">
                            {{ company.stagiaires ?? 0 }} stagiaires ayant postulé
                        </p>

                        <a href="/index.php?page=company_detail&id={{ company.ID }}" class="btn-voir">
                            Découvrir
                        </a>
                    </div>
                </article>
            {% else %}
                <p class="company-list-empty">Aucune entreprise trouvée.</p>
            {% endfor %}

        </div>

        <nav class="pagination" aria-label="Pagination des entreprises">

            {% if pageCourante > 1 %}
                <a href="?page=company&p={{ pageCourante - 1 }}" class="page-arrow" aria-label="Page précédente">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            {% else %}
                <button class="page-arrow" type="button" disabled>
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            {% endif %}

            <div class="page-numbers">
                {% for i in 1..totalPages %}
                    <a href="?page=company&p={{ i }}"
                       class="page-number {% if i == pageCourante %}active{% endif %}">
                        {{ i }}
                    </a>
                {% endfor %}
            </div>

            {% if pageCourante < totalPages %}
                <a href="?page=company&p={{ pageCourante + 1 }}" class="page-arrow" aria-label="Page suivante">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            {% else %}
                <button class="page-arrow" type="button" disabled>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            {% endif %}

        </nav>
    </div>

</main>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('click', function(e) {
        const paginationLink = e.target.closest('.pagination a');
        if (!paginationLink) return;

        e.preventDefault();
        const url = paginationLink.href;
        const container = document.getElementById('company-list-container');

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newContent = doc.getElementById('company-list-container').innerHTML;
                container.innerHTML = newContent;
                window.history.pushState({path: url}, '', url);
                window.scrollTo({ top: container.offsetTop - 50, behavior: 'smooth' });
            })
            .catch(() => { window.location.href = url; });
    });
</script>
{% endblock %}