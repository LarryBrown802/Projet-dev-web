{% extends 'base.html.twig' %}

{% block title %}Company{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Pilote.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Gestion des entreprises</h1>
            <p class="page-subtitle">Créer, modifier, évaluer ou supprimer des fiches entreprises.</p>
        </div>
        {# On ajoute l'ID 'btn-open-create-company' ici pour le JS #}
        <button class="btn-add" type="button" id="btn-open-create-company">
            <i class="fa-solid fa-plus"></i> Nouvelle entreprise
        </button>
    </div>

    {# --- AFFICHAGE DES MESSAGES SUCCÈS / ERREUR --- #}
    {% if message %}
        <div style="background: #e6f8f3; color: #1a7b5e; padding: 16px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
            <i class="fa-solid fa-check"></i> {{ message }}
        </div>
    {% endif %}
    {% if error %}
        <div style="background: #ffe6e6; color: #d8000c; padding: 16px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
            <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
        </div>
    {% endif %}
    {# --------------------------------------------- #}

    <div class="search-bar-wrap">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" placeholder="Rechercher une entreprise par nom…" aria-label="Rechercher une entreprise" />
        </div>
    </div>

    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Entreprise</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Stagiaires ayant postulé</th>
                    <th>Note moy.</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for company in companies %}
                <tr>
                    {# Note: on utilise company.name car c'est le vrai nom de la colonne MySQL #}
                    <td><strong>{{ company.name }}</strong></td>
                    <td>{{ company.email }}</td>
                    <td>{{ company.number }}</td>
                    <td>0</td> {# Les stagiaires ayant postulé devront être calculés via une jointure SQL plus tard si tu le souhaites #}
                    <td>
                        <span class="stars">
                            {# Exemple de notation par défaut si average_mark est null #}
                            {% set note = company.average_mark|default(3) %}
                            {% for i in 1..5 %}
                                {% if i <= note %}
                                    <i class="fa-solid fa-star"></i>
                                {% else %}
                                    <i class="fa-regular fa-star"></i>
                                {% endif %}
                            {% endfor %}
                            <span style="margin-left:4px;font-weight:800">{{ note }}/5</span>
                        </span>
                    </td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-edit" title="Modifier"
                            data-nom="{{ company.name }}"
                            data-email="{{ company.email }}"
                            data-tel="{{ company.number }}"
                            data-desc="{{ company.description }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-rate" title="Évaluer"
                            data-nom="{{ company.name }}">
                            <i class="fa-solid fa-star"></i>
                        </button>
                        <button class="btn-icon btn-delete" title="Supprimer"
                            data-nom="{{ company.name }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="6" style="text-align: center; padding: 20px;">Aucune entreprise trouvée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Pagination des offres">
        <button class="page-arrow" type="button"
            {% if pageCourante <= 1 %}disabled{% endif %}
            onclick="window.location='?page=company_management&p={{ pageCourante - 1 }}'">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <button class="page-number {% if p == pageCourante %}active{% endif %}"
                        type="button"
                        onclick="window.location='?page=company_management&p={{ p }}'">
                        {{ p }}
                    </button>
                {% endif %}
            {% endfor %}
        </div>

        <button class="page-arrow" type="button"
            {% if pageCourante >= totalPages %}disabled{% endif %}
            onclick="window.location='?page=company_management&p={{ pageCourante + 1 }}'">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </nav>

</main>

<dialog class="dialog" id="createCompanyDialog" aria-labelledby="createCompanyTitle" style="padding: 0; border-radius: 14px; overflow: hidden; max-width: 600px; width: 100%; border: 1px solid var(--border);">
    <form method="POST" action="/index.php?page=company_management" style="display: flex; flex-direction: column;">
        <input type="hidden" name="action" value="create_company">
        
        <header style="display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border); background: var(--card);">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: #e0f2f1; color: #5E92A6; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div>
                    <h2 id="createCompanyTitle" style="margin: 0; font-size: 20px;">Ajouter une entreprise</h2>
                    <p style="color: var(--muted); margin: 4px 0 0 0; font-size: 14px;">Cette entreprise sera ajoutée à votre portefeuille.</p>
                </div>
            </div>
            <button type="button" class="dialog-close" id="btn-close-company" aria-label="Fermer" style="position: static; margin: 0; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: none; border: none; font-size: 18px; cursor: pointer;">✕</button>
        </header>

        <div style="padding: 24px; background: var(--bg); display: grid; gap: 16px;">
            <div>
                <label style="font-weight: 700; font-size: 14px; margin-bottom: 8px; display: block; color: var(--text);">Nom de l'entreprise <span style="color: #d8000c;">*</span></label>
                <input type="text" name="name" required placeholder="Ex: Tech Solutions" style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit;">
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-weight: 700; font-size: 14px; margin-bottom: 8px; display: block; color: var(--text);">Email de contact</label>
                    <input type="email" name="email" placeholder="contact@entreprise.com" style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit;">
                </div>
                <div>
                    <label style="font-weight: 700; font-size: 14px; margin-bottom: 8px; display: block; color: var(--text);">Téléphone</label>
                    <input type="tel" name="tel" placeholder="01 23 45 67 89" style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit;">
                </div>
            </div>

            <div>
                <label style="font-weight: 700; font-size: 14px; margin-bottom: 8px; display: block; color: var(--text);">Description</label>
                <textarea name="description" rows="4" placeholder="Présentation de l'entreprise..." style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; resize: vertical; outline: none;"></textarea>
            </div>
        </div>

        <footer style="padding: 20px 24px; border-top: 1px solid var(--border); background: var(--card); display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" class="btn-secondary" id="btn-cancel-company" style="padding: 12px 24px; border-radius: 8px; font-weight: bold; cursor: pointer; border: 1px solid var(--border); background: var(--bg);">Annuler</button>
            <button type="submit" class="btn-primary" style="padding: 12px 24px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">Ajouter l'entreprise</button>
        </footer>
    </form>
</dialog>
{% endblock %}

{% block javascripts %}
<script>
    const companyDialog = document.getElementById('createCompanyDialog');
    const openCompanyBtn = document.getElementById('btn-open-create-company');
    
    // Ouvrir le modal
    if(openCompanyBtn) {
        openCompanyBtn.addEventListener('click', () => {
            companyDialog.showModal();
        });
    }
    
    // Fermer le modal
    document.getElementById('btn-close-company')?.addEventListener('click', () => companyDialog.close());
    document.getElementById('btn-cancel-company')?.addEventListener('click', () => companyDialog.close());

    // Fermer en cliquant à l'extérieur
    companyDialog.addEventListener('click', e => {
        const r = companyDialog.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
            companyDialog.close();
        }
    });
</script>
{% endblock %}