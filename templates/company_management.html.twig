{% extends 'base.html.twig' %}

{% block metas %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Gestion des entreprises - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Pilote.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Gestion des entreprises</h1>
            <p class="page-subtitle">Créer, modifier, évaluer ou supprimer des fiches entreprises.</p>
        </div>
        <button class="btn-add" type="button" id="btnCreateEntreprise">
            <i class="fa-solid fa-plus"></i> Nouvelle entreprise
        </button>
    </div>

    {% if message %}
        <div class="alert alert-success">
            <i class="fa-solid fa-check"></i> {{ message }}
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
        </div>
    {% endif %}

    <form method="get" action="/index.php" class="search-bar-wrap">
        <input type="hidden" name="page" value="company_management">
        <input type="hidden" name="p" value="1">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="search" value="{{ search|default('') }}"
                   placeholder="Rechercher une entreprise par nom…" aria-label="Rechercher une entreprise">
        </div>
    </form>

    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Entreprise</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Stagiaires ayant postulé</th>
                    <th>Note moy.</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for company in companies %}
                <tr>
                    <td><strong>{{ company.name }}</strong></td>
                    <td>{{ company.email }}</td>
                    <td>{{ company.number ?? '—' }}</td>
                    <td>{{ company.stagiaires ?? 0 }}</td>
                    <td>
                        <span class="stars">
                            {% set note = company.average_mark ?? 0 %}
                            {% set RoundedNote = note|round %}
                            {% for i in 1..5 %}
                                {% if i <= RoundedNote %}
                                    <i class="fa-solid fa-star"></i>
                                {% else %}
                                    <i class="fa-regular fa-star"></i>
                                {% endif %}
                            {% endfor %}
                            <span class="stars-value">{{ note }}/5</span>
                        </span>
                    </td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-edit" title="Modifier"
                            data-id="{{ company.ID }}"
                            data-name="{{ company.name }}"
                            data-email="{{ company.email }}"
                            data-number="{{ company.number ?? '' }}"
                            data-description="{{ company.description ?? '' }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-rate" title="Évaluer"
                            data-id="{{ company.ID }}"
                            data-name="{{ company.name }}">
                            <i class="fa-solid fa-star"></i>
                        </button>
                        <button class="btn-icon btn-delete" title="Supprimer"
                            data-id="{{ company.ID }}"
                            data-name="{{ company.name }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="6" class="table-empty">Aucune entreprise trouvée.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Pagination des entreprises">

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="company_management">
            <input type="hidden" name="p" value="{{ pageCourante - 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante <= 1 %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </form>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <form method="get" action="/index.php">
                        <input type="hidden" name="page" value="company_management">
                        <input type="hidden" name="p" value="{{ p }}">
                        <input type="hidden" name="search" value="{{ search|default('') }}">
                        <button class="page-number {% if p == pageCourante %}active{% endif %}" type="submit">
                            {{ p }}
                        </button>
                    </form>
                {% endif %}
            {% endfor %}
        </div>

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="company_management">
            <input type="hidden" name="p" value="{{ pageCourante + 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante >= totalPages %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </form>

    </nav>

</main>

{# ===== DIALOG CRÉER ===== #}
<dialog class="dialog dialog--sm" id="dialogCreateEnt">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-building"></i></div>
            <div><h2>Nouvelle entreprise</h2><p class="dialog-company">Remplissez la fiche.</p></div>
            <button class="dialog-close" id="btnCloseCreateEnt" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=company_management">
            <input type="hidden" name="action" value="create">
            <div class="field-group">
                <div class="field">
                    <label for="cENom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-building"></i><input id="cENom" name="name" type="text" placeholder="Nom de l'entreprise" required></div>
                </div>
                <div class="field">
                    <label for="cEEmail">Email <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-envelope"></i><input id="cEEmail" name="email" type="email" placeholder="contact@entreprise.fr" required></div>
                </div>
            </div>
            <div class="field">
                <label for="cETel">Téléphone</label>
                <div class="input"><i class="fa-solid fa-phone"></i><input id="cETel" name="number" type="tel" placeholder="01 23 45 67 89"></div>
            </div>
            <div class="field">
                <label for="cEDesc">Description</label>
                <textarea id="cEDesc" name="description" rows="3" placeholder="Activité, valeurs…"></textarea>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelCreateEnt">Annuler</button>
                <button class="btn-voir" type="submit">Créer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG MODIFIER ===== #}
<dialog class="dialog dialog--sm" id="dialogEditEnt">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-pen"></i></div>
            <div><h2>Modifier l'entreprise</h2><p class="dialog-company" id="editEntName">—</p></div>
            <button class="dialog-close" id="btnCloseEditEnt" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=company_management">
            <input type="hidden" name="action" value="update">
            <input type="hidden" name="id" id="eEId">
            <div class="field-group">
                <div class="field">
                    <label for="eENom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-building"></i><input id="eENom" name="name" type="text" required></div>
                </div>
                <div class="field">
                    <label for="eEEmail">Email <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-envelope"></i><input id="eEEmail" name="email" type="email" required></div>
                </div>
            </div>
            <div class="field">
                <label for="eETel">Téléphone</label>
                <div class="input"><i class="fa-solid fa-phone"></i><input id="eETel" name="number" type="tel"></div>
            </div>
            <div class="field">
                <label for="eEDesc">Description</label>
                <textarea id="eEDesc" name="description" rows="3"></textarea>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelEditEnt">Annuler</button>
                <button class="btn-voir" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG ÉVALUER ===== #}
<dialog class="dialog dialog--sm" id="dialogRateEnt">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--rate"><i class="fa-solid fa-star"></i></div>
            <div><h2>Évaluer l'entreprise</h2><p class="dialog-company" id="rateEntName">—</p></div>
            <button class="dialog-close" id="btnCloseRateEnt" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=company_management">
            <input type="hidden" name="action" value="rate">
            <input type="hidden" name="id" id="rateEId">
            <div class="field">
                <label>Note <span class="required">*</span></label>
                <div class="star-picker" role="group">
                    <input type="radio" name="note" id="s5" value="5"><label for="s5"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" name="note" id="s4" value="4"><label for="s4"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" name="note" id="s3" value="3"><label for="s3"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" name="note" id="s2" value="2"><label for="s2"><i class="fa-solid fa-star"></i></label>
                    <input type="radio" name="note" id="s1" value="1"><label for="s1"><i class="fa-solid fa-star"></i></label>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelRateEnt">Annuler</button>
                <button class="btn-voir" type="submit">Envoyer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG SUPPRIMER ===== #}
<dialog class="dialog dialog--sm" id="dialogDeleteEnt">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--danger"><i class="fa-solid fa-trash"></i></div>
            <div><h2>Supprimer l'entreprise</h2><p class="dialog-company" id="deleteEntName">—</p></div>
            <button class="dialog-close" id="btnCloseDeleteEnt" type="button">✕</button>
        </header>
        <div class="dialog-confirm-body">
            <p>Êtes-vous sûr de vouloir supprimer cette entreprise ? Cette action est <strong>irréversible</strong>.</p>
        </div>
        <form method="post" action="/index.php?page=company_management">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="id" id="dEId">
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelDeleteEnt">Annuler</button>
                <button class="btn-danger" type="submit">Supprimer</button>
            </div>
        </form>
    </div>
</dialog>

{% endblock %}

{% block javascripts %}
<script>
    function openDialog(id) { document.getElementById(id).showModal(); }
    function closeDialog(id) { document.getElementById(id).close(); }

    ['dialogCreateEnt', 'dialogEditEnt', 'dialogRateEnt', 'dialogDeleteEnt'].forEach(id => {
        const d = document.getElementById(id);
        d.addEventListener('click', e => {
            const r = d.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close();
        });
    });

    document.getElementById('btnCreateEntreprise').onclick  = () => openDialog('dialogCreateEnt');
    document.getElementById('btnCloseCreateEnt').onclick    = () => closeDialog('dialogCreateEnt');
    document.getElementById('btnCancelCreateEnt').onclick   = () => closeDialog('dialogCreateEnt');

    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('editEntName').textContent  = btn.dataset.name;
            document.getElementById('eEId').value               = btn.dataset.id;
            document.getElementById('eENom').value              = btn.dataset.name        || '';
            document.getElementById('eEEmail').value            = btn.dataset.email       || '';
            document.getElementById('eETel').value              = btn.dataset.number      || '';
            document.getElementById('eEDesc').value             = btn.dataset.description || '';
            openDialog('dialogEditEnt');
        };
    });
    document.getElementById('btnCloseEditEnt').onclick  = () => closeDialog('dialogEditEnt');
    document.getElementById('btnCancelEditEnt').onclick = () => closeDialog('dialogEditEnt');

    document.querySelectorAll('.btn-rate').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('rateEntName').textContent = btn.dataset.name;
            document.getElementById('rateEId').value           = btn.dataset.id;
            openDialog('dialogRateEnt');
        };
    });
    document.getElementById('btnCloseRateEnt').onclick  = () => closeDialog('dialogRateEnt');
    document.getElementById('btnCancelRateEnt').onclick = () => closeDialog('dialogRateEnt');

    document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('deleteEntName').textContent = btn.dataset.name;
            document.getElementById('dEId').value                = btn.dataset.id;
            openDialog('dialogDeleteEnt');
        };
    });
    document.getElementById('btnCloseDeleteEnt').onclick  = () => closeDialog('dialogDeleteEnt');
    document.getElementById('btnCancelDeleteEnt').onclick = () => closeDialog('dialogDeleteEnt');
</script>
{% endblock %}