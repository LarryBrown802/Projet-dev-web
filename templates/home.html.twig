{% extends 'base.html.twig' %}

{% block title %}Accueil - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/accueil.css?v=2">
{% endblock %}

{% block content %}
    <section class="hero">
        <div class="hero-bg">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h2 class="hero-text">Notre job, vous aider</h2>
                <span class="hero-text">à choisir le vôtre parmi</span>
                <span class="hero-big">{{ latestOffers|length }} offres</span>
            </div>
        </div>

        <form class="hero-search" action="/index.php" method="GET">
            <input type="hidden" name="page" value="offers">
            <div class="searchbox">
                <div class="searchbox-field">
                    <label for="q">QUOI ?</label>
                    <input id="q" name="search" type="text" placeholder="Métier, entreprise, compétence..." >
                </div>
                <div class="searchbox-divider"></div>
                <div class="searchbox-field">
                    <label for="where">OÙ ?</label>
                    <input id="where" name="location" type="text" placeholder="Ville, département, code postal..." >
                </div>
                <button class="searchbox-btn" type="submit" aria-label="Rechercher">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
    </section>

    <h2>Dernières offres mise en ligne</h2>

    <div class="offers-grid">
        <aside class="list">
            <div class="list-cards">
                {% for offer in latestOffers %}
                    
                    {# --- LOGIQUE DES ICONES DYNAMIQUES (Améliorée) --- #}
                    {% set lowerTitle = offer.title|lower %}
                    {% set iconClass = 'fa-briefcase' %}
                    
                    {% if 'dev' in lowerTitle or 'dév' in lowerTitle %}
                        {% set iconClass = 'fa-laptop-code' %}
                    {% elseif 'data' in lowerTitle or 'donnée' in lowerTitle %}
                        {% set iconClass = 'fa-chart-line' %}
                    {% elseif 'cyber' in lowerTitle or 'secur' in lowerTitle or 'sécur' in lowerTitle %}
                        {% set iconClass = 'fa-shield-halved' %}
                    {% elseif 'réseau' in lowerTitle or 'reseau' in lowerTitle or 'support' in lowerTitle %}
                        {% set iconClass = 'fa-server' %}
                    {% elseif 'consultant' in lowerTitle or 'projet' in lowerTitle %}
                        {% set iconClass = 'fa-user-tie' %}
                    {% endif %}
                    {# ------------------------------------------------- #}

                    <article class="mini-card js-offer-trigger {% if loop.first %}active{% endif %}"
                        data-id="{{ offer.ID_offer }}"
                        data-poste="{{ offer.title }}"
                        data-entreprise="{{ offer.entreprise }}"
                        data-lieu="{{ offer.lieu }}"
                        data-type="{{ offer.type }}"
                        data-niveau="{{ offer.level }}"
                        data-duree="{{ offer.duration }}"
                        data-desc="{{ offer.description }}"
                        data-entdesc="{{ offer.entrepriseDesc ?? '' }}"
                        data-icon="{{ iconClass }}" {# <-- On passe l'icone au JS #}
                    >
                        <div class="mini-logo">
                            <i class="fa-solid {{ iconClass }}"></i>
                        </div>

                        <div>
                            <h3 class="mini-title">
                                {{ offer.entreprise }}<br>
                                {{ offer.title }}
                            </h3>
                            <p class="mini-info">
                                <span><i class="fa-solid fa-paperclip fa-rotate-by" style="--fa-rotate-angle: -45deg;"></i>{{ offer.type }}</span>
                                <span><i class="fa-solid fa-location-dot"></i>{{ offer.lieu }}</span>
                                <span><i class="fa-solid fa-ranking-star"></i>{{ offer.level }}</span>
                            </p>
                        </div>

                        {% if session.role == 'etudiant' %}
                        <label class="ui-bookmark js-bookmark-label">
                            <input type="checkbox" class="bookmark-checkbox" data-offer-id="{{ offer.ID_offer }}"
                                {% if wishlistIds is defined and offer.ID_offer in wishlistIds %}checked{% endif %}>
                            <span class="bookmark">
                                <svg viewBox="0 0 32 32">
                                    <path d="M27 4v27a1 1 0 0 1-1.625.781L16 24.281l-9.375 7.5A1 1 0 0 1 5 31V4a4 4 0 0 1 4-4h14a4 4 0 0 1 4 4z"></path>
                                </svg>
                            </span>
                        </label>
                        {% endif %}
                    </article>
                {% else %}
                    <p>Aucune offre disponible pour le moment.</p>
                {% endfor %}
            </div>

            <div class="list-footer">
                <a href="/index.php?page=offers" class="btn-voirplus">Voir plus</a>
            </div>
        </aside>

        {% if latestOffers is not empty %}
            {% set firstOffer = latestOffers|first %}

            {# --- On applique la même logique d'icône pour la première offre à droite --- #}
            {% set lowerTitleFirst = firstOffer.title|lower %}
            {% set firstIconClass = 'fa-briefcase' %}
            
            {% if 'dev' in lowerTitleFirst or 'dév' in lowerTitleFirst %}
                {% set firstIconClass = 'fa-laptop-code' %}
            {% elseif 'data' in lowerTitleFirst or 'donnée' in lowerTitleFirst %}
                {% set firstIconClass = 'fa-chart-line' %}
            {% elseif 'cyber' in lowerTitleFirst or 'secur' in lowerTitleFirst or 'sécur' in lowerTitleFirst %}
                {% set firstIconClass = 'fa-shield-halved' %}
            {% elseif 'réseau' in lowerTitleFirst or 'reseau' in lowerTitleFirst or 'support' in lowerTitleFirst %}
                {% set firstIconClass = 'fa-server' %}
            {% elseif 'consultant' in lowerTitleFirst or 'projet' in lowerTitleFirst %}
                {% set firstIconClass = 'fa-user-tie' %}
            {% endif %}

            <article class="detail">
                <div class="detail-head">
                    <div class="detail-img" id="detail-icon-container">
                        <i id="detail-icon-main" class="fa-solid {{ firstIconClass }}"></i>
                    </div>
                    <div>
                        <p class="detail-title" id="detail-entreprise">{{ firstOffer.entreprise }}</p>
                        <h3 class="detail-sub" id="detail-poste">{{ firstOffer.title }}</h3>
                    </div>

                    {% if session.role == 'etudiant' %}
                    <label class="ui-bookmark">
                        {# On ajoute l'ID 'detail-bookmark-checkbox' ici pour le JS ! #}
                        <input type="checkbox" id="detail-bookmark-checkbox" class="bookmark-checkbox" data-offer-id="{{ firstOffer.ID_offer }}"
                            {% if wishlistIds is defined and firstOffer.ID_offer in wishlistIds %}checked{% endif %}>
                        <span class="bookmark">
                            <svg viewBox="0 0 32 32">
                                <path d="M27 4v27a1 1 0 0 1-1.625.781L16 24.281l-9.375 7.5A1 1 0 0 1 5 31V4a4 4 0 0 1 4-4h14a4 4 0 0 1 4 4z"></path>
                            </svg>
                        </span>
                    </label>
                    {% endif %}
                </div>

                <div class="tags">
                    <span class="tag t-yellow" id="detail-tag-lieu">{{ firstOffer.lieu }}</span>
                    <span class="tag t-red"    id="detail-tag-type">{{ firstOffer.type }}</span>
                    <span class="tag t-purple" id="detail-tag-duree">{{ firstOffer.duration }}</span>
                    <span class="tag t-green"  id="detail-tag-niveau">{{ firstOffer.level }}</span>
                </div>

                <div class="tabs" role="tablist" aria-label="Détails de l'offre">
                    <button class="tab-btn active" type="button" data-tab="desc" role="tab" id="tab-btn-desc" aria-controls="tab-desc" aria-selected="true">Description</button>
                    <button class="tab-btn" type="button" data-tab="company" role="tab" id="tab-btn-company" aria-controls="tab-company" aria-selected="false">Entreprise</button>
                </div>

                <div class="detail-body">
                    <div class="tab-content active" id="tab-desc" data-content="desc" role="tabpanel" aria-labelledby="tab-btn-desc">
                        <p class="section-title">Description du poste</p>
                        <p class="para" id="detail-desc-text">{{ firstOffer.description }}</p>

                        <p class="section-title">Prérequis</p>
                        <p class="para">
                            Niveau demandé : <span id="detail-req-niveau">{{ firstOffer.level }}</span><br>
                            Type de contrat : <span id="detail-req-type">{{ firstOffer.type }}</span><br>
                            Durée : <span id="detail-req-duree">{{ firstOffer.duration }}</span>
                        </p>
                    </div>

                    <div class="tab-content" id="tab-company" data-content="company" role="tabpanel" aria-labelledby="tab-btn-company" hidden>
                        <p class="section-title">À propos de l'entreprise</p>
                        <p class="para" id="detail-entdesc-text">{{ firstOffer.entrepriseDesc ?? 'Aucune description disponible.' }}</p>

                        <p class="section-title">Technos / environnement</p>
                        <p class="para">Environnement professionnel, missions variées et accompagnement sur le poste.</p>
                    </div>
                </div>

                <div class="detail-footer">
                {% if session.role == 'etudiant' %}
                    <button class="apply-btn js-apply-btn" type="button" data-id="{{ firstOffer.ID_offer }}">Postuler</button>
                {% else %}
                    <a href="/index.php?page=connexion" class="apply-btn" style="text-decoration:none;text-align:center;display:block">
                        Se connecter pour postuler
                    </a>
                {% endif %}                </div>
            </article>
        {% endif %}
    </div>

    {# ===== FAQ ===== #}
    <div class="faq-title">F.A.Q</div>
    <div class="faq">
        <details>
            <summary>Comment rechercher une offre ? <span class="plus"></span></summary>
            <p>Utilisez la barre de recherche en haut de la page d'accueil...</p>
        </details>
        <details>
            <summary>Comment postuler ? <span class="plus"></span></summary>
            <p>Une fois l'offre consultée, cliquez sur le bouton "Postuler"...</p>
        </details>
        <details>
            <summary>Puis-je filtrer les offres ? <span class="plus"></span></summary>
            <p>Oui, la page Offres permet de filtrer les résultats...</p>
        </details>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/javascript/home.js"></script>
{% endblock %}
