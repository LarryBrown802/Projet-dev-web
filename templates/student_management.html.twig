{% extends 'base.html.twig' %}

{% block title %}Gestion des étudiants{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Pilote.css">
{% endblock %}

{% block content %}

{% if message %}
        <div style="background: #e6f8f3; color: #1a7b5e; padding: 16px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
            <i class="fa-solid fa-check"></i> {{ message }}
        </div>
    {% endif %}
    {% if error %}
        <div style="background: #ffe6e6; color: #d8000c; padding: 16px; border-radius: 8px; margin-bottom: 20px; font-weight: bold;">
            <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
        </div>
    {% endif %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>
                {% if session.role == 'admin' %}
                    Gestion de tous les étudiants
                {% else %}
                    Mes étudiants
                {% endif %}
            </h1>
            <p class="page-subtitle">Consultez les profils, les candidatures et l'état de la recherche de stage.</p>
        </div>
        {% if session.role == 'admin' or session.role == 'pilote' %}
            <button class="btn-add" type="button" id="btnCreateEtu"> {# ← corrigé : btnCreateEtudiant → btnCreateEtu #}
                <i class="fa-solid fa-plus"></i> Nouvel étudiant
            </button>
        {% endif %}
    </div>

    <div class="search-bar-wrap">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" placeholder="Rechercher par nom, prénom ou email…" aria-label="Rechercher un étudiant" />
        </div>
    </div>

    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Promotion</th>
                    <th>Candidatures</th>
                    <th>Statut recherche</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for student in students %}
                <tr>
                    <td><strong>{{ student.nom }}</strong></td>
                    <td>{{ student.prenom }}</td>
                    <td>{{ student.email }}</td>
                    <td>{{ student.promotion | default('Non défini') }}</td>
                    <td>{{ student.candidatures }}</td>
                    <td>
                        {% if student.statut == 'ok' %}
                            <span class="badge badge--ok">Stage trouvé</span>
                        {% elseif student.statut == 'no' %}
                            <span class="badge badge--no">Non trouvé</span>
                        {% else %}
                            <span class="badge badge--wait">En cours</span>
                        {% endif %}
                    </td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-view-etu" title="Voir les candidatures"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}"
                            data-email="{{ student.email }}"
                            data-candidatures="{{ student.candidatures_detail }}"> {# ← supprimé data-pilote inexistant #}
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="btn-icon btn-edit-etu" title="Modifier"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}"
                            data-email="{{ student.email }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-delete-etu" title="Supprimer"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="7">Aucun étudiant trouvé.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Pagination des étudiants">
        <button class="page-arrow" type="button"
            {% if pageCourante <= 1 %}disabled{% endif %}
            onclick="window.location='?page=student_management&p={{ pageCourante - 1 }}&search={{ search|default('') }}'">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <button class="page-number {% if p == pageCourante %}active{% endif %}"
                        type="button"
                        onclick="window.location='?page=student_management&p={{ p }}&search={{ search|default('') }}'">
                        {{ p }}
                    </button>
                {% endif %}
            {% endfor %}
        </div>

        <button class="page-arrow" type="button"
            {% if pageCourante >= totalPages %}disabled{% endif %}
            onclick="window.location='?page=student_management&p={{ pageCourante + 1 }}&search={{ search|default('') }}'">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    </nav>

</main>

<!-- ===== DIALOGS ===== -->
<dialog class="dialog" id="dialogViewEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo kpi-green"><i class="fa-solid fa-user-graduate"></i></div>
            <div>
                <h2 id="viewEtuTitle">—</h2>
                <p class="dialog-company" id="viewEtuInfo">—</p>
            </div>
            <button class="dialog-close" id="btnCloseViewEtu" type="button">✕</button>
        </header>
        <div style="margin-top:14px">
            <h3 style="margin:0 0 10px;font-size:15px">Candidatures envoyées</h3>
            <div class="table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr><th>Offre</th><th>Entreprise</th><th>Date</th><th>Statut</th></tr>
                    </thead>
                    <tbody id="viewEtuTbody"></tbody>
                </table>
            </div>
        </div>
        <footer class="dialog-actions" style="margin-top:14px">
            <button class="btn-secondary" id="btnCloseViewEtu2">Fermer</button>
        </footer>
    </div>
</dialog>

<dialog class="dialog dialog--sm" id="dialogCreateEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-user-plus"></i></div>
            <div><h2>Nouvel étudiant</h2><p class="dialog-company">Créer un compte étudiant.</p></div>
            <button class="dialog-close" id="btnCloseCreateEtu" type="button">✕</button>
        </header>
        <form class="dialog-form" id="formCreateEtu" novalidate>
            <div class="field-group">
                <div class="field">
                    <label for="cNom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cNom" type="text" placeholder="Nom" required /></div>
                </div>
                <div class="field">
                    <label for="cPrenom">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cPrenom" type="text" placeholder="Prénom" required /></div>
                </div>
            </div>
            <div class="field">
                <label for="cEmail">Email <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-envelope"></i><input id="cEmail" type="email" placeholder="prenom.nom@viacesi.fr" required /></div>
            </div>
            <div class="field">
                <label for="cPassword">Mot de passe <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-lock"></i><input id="cPassword" type="password" placeholder="Mot de passe" required /></div>
            </div>
            <div class="field">
                <label for="cPilote">Pilote référent</label>
                <div class="input">
                    <i class="fa-solid fa-chalkboard-teacher"></i>
                    <select id="cPilote" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="">Sélectionner…</option>
                        <option>Dupont Jean</option>
                        <option>Durand Marie</option>
                        <option>Martin Paul</option>
                    </select>
                </div>
            </div>
            <footer class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelCreateEtu">Annuler</button>
                <button class="btn-voir" type="submit">Créer</button>
            </footer>
        </form>
    </div>
</dialog>

<dialog class="dialog dialog--sm" id="dialogEditEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-pen"></i></div>
            <div><h2>Modifier l'étudiant</h2><p class="dialog-company" id="editEtuSubtitle">—</p></div>
            <button class="dialog-close" id="btnCloseEditEtu" type="button">✕</button>
        </header>
        <form class="dialog-form" id="formEditEtu" novalidate>
            <div class="field-group">
                <div class="field">
                    <label for="eNom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="eNom" type="text" required /></div>
                </div>
                <div class="field">
                    <label for="ePrenom">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="ePrenom" type="text" required /></div>
                </div>
            </div>
            <div class="field">
                <label for="eEmail">Email <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-envelope"></i><input id="eEmail" type="email" required /></div>
            </div>
            <footer class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelEditEtu">Annuler</button>
                <button class="btn-voir" type="submit">Enregistrer</button>
            </footer>
        </form>
    </div>
</dialog>

<dialog class="dialog dialog--sm" id="dialogDeleteEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--danger"><i class="fa-solid fa-trash"></i></div>
            <div><h2>Supprimer l'étudiant</h2><p class="dialog-company" id="deleteEtuName">—</p></div>
            <button class="dialog-close" id="btnCloseDeleteEtu" type="button">✕</button>
        </header>
        <div class="dialog-confirm-body">
            <p>Cette action est <strong>irréversible</strong>. Le compte et toutes les données seront supprimés.</p>
        </div>
        <footer class="dialog-actions">
            <button class="btn-secondary" type="button" id="btnCancelDeleteEtu">Annuler</button>
            <button class="btn-danger" type="button" id="btnConfirmDeleteEtu">Supprimer</button>
        </footer>
    </div>
</dialog>

{% endblock %}

{% block javascripts %}
<script>
    // Helpers ouverture/fermeture dialogs
    function openDialog(id) { document.getElementById(id).showModal(); }
    function closeDialog(id) { document.getElementById(id).close(); }

    // Fermeture au clic sur le backdrop
    ['dialogViewEtu', 'dialogCreateEtu', 'dialogEditEtu', 'dialogDeleteEtu'].forEach(id => {
        const d = document.getElementById(id);
        d.addEventListener('click', e => {
            const r = d.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
                d.close();
            }
        });
    });

    const statutLabel = { ok: 'Accepté', wait: 'En attente', no: 'Refusé' };
    const statutClass = { ok: 'badge--ok', wait: 'badge--wait', no: 'badge--no' };

    // ===== VOIR =====
    document.querySelectorAll('.btn-view-etu').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('viewEtuTitle').textContent = btn.dataset.prenom + ' ' + btn.dataset.nom;
            document.getElementById('viewEtuInfo').textContent = btn.dataset.email;
            const tbody = document.getElementById('viewEtuTbody');
            tbody.innerHTML = '';
            try {
                JSON.parse(btn.dataset.candidatures || '[]').forEach(c => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td><strong>${c.offre}</strong></td><td>${c.entreprise}</td><td>${c.date}</td><td><span class="badge ${statutClass[c.statut]}">${statutLabel[c.statut]}</span></td>`;
                    tbody.appendChild(tr);
                });
            } catch(e) {
                tbody.innerHTML = '<tr><td colspan="4">Aucune candidature.</td></tr>';
            }
            openDialog('dialogViewEtu');
        };
    });
    document.getElementById('btnCloseViewEtu').onclick  = () => closeDialog('dialogViewEtu');
    document.getElementById('btnCloseViewEtu2').onclick = () => closeDialog('dialogViewEtu');

    // ===== CRÉER =====
    document.getElementById('btnCreateEtu').onclick        = () => openDialog('dialogCreateEtu');
    document.getElementById('btnCloseCreateEtu').onclick   = () => closeDialog('dialogCreateEtu');
    document.getElementById('btnCancelCreateEtu').onclick  = () => closeDialog('dialogCreateEtu');
    document.getElementById('formCreateEtu').onsubmit = e => {
        e.preventDefault();
        alert('Étudiant créé (démo)');
        closeDialog('dialogCreateEtu');
    };

    // ===== MODIFIER =====
    document.querySelectorAll('.btn-edit-etu').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('editEtuSubtitle').textContent = btn.dataset.prenom + ' ' + btn.dataset.nom;
            document.getElementById('eNom').value    = btn.dataset.nom    || '';
            document.getElementById('ePrenom').value = btn.dataset.prenom || '';
            document.getElementById('eEmail').value  = btn.dataset.email  || '';
            openDialog('dialogEditEtu');
        };
    });
    document.getElementById('btnCloseEditEtu').onclick  = () => closeDialog('dialogEditEtu');
    document.getElementById('btnCancelEditEtu').onclick = () => closeDialog('dialogEditEtu');
    document.getElementById('formEditEtu').onsubmit = e => {
        e.preventDefault();
        alert('Modifications enregistrées (démo)');
        closeDialog('dialogEditEtu');
    };

    // ===== SUPPRIMER =====
    document.querySelectorAll('.btn-delete-etu').forEach(btn => {
        btn.onclick = () => {
            document.getElementById('deleteEtuName').textContent = btn.dataset.prenom + ' ' + btn.dataset.nom;
            openDialog('dialogDeleteEtu');
        };
    });
    document.getElementById('btnCloseDeleteEtu').onclick   = () => closeDialog('dialogDeleteEtu');
    document.getElementById('btnCancelDeleteEtu').onclick  = () => closeDialog('dialogDeleteEtu');
    document.getElementById('btnConfirmDeleteEtu').onclick = () => {
        alert('Étudiant supprimé (démo)');
        closeDialog('dialogDeleteEtu');
    };
</script>
{% endblock %}
