{% extends 'base.html.twig' %}

{% block metas %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Gestion des étudiants - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Admin.css">
{% endblock %}

{% block content %}
<main class="container">

    {# ===== MESSAGES ===== #}
    {% if message %}
        <div class="alert alert-success">
            <i class="fa-solid fa-check"></i> {{ message }}
        </div>
    {% endif %}
    {% if error %}
        <div class="alert alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
        </div>
    {% endif %}

    <div class="page-head">
        <div>
            <h1>
                {% if session.role == 'administrateur' %}
                    Gestion de tous les étudiants
                {% else %}
                    Mes étudiants
                {% endif %}
            </h1>
            <p class="page-subtitle">Consultez les profils, les candidatures et l'état de la recherche de stage.</p>
        </div>
        {% if session.role == 'administrateur' or session.role == 'pilote' %}
            <button class="btn-add" type="button" id="btnCreateEtu">
                <i class="fa-solid fa-plus"></i> Nouvel étudiant
            </button>
        {% endif %}
    </div>

    {# ===== BARRE DE RECHERCHE ===== #}
    <form method="get" action="/index.php" class="search-bar-wrap">
        <input type="hidden" name="page" value="student_management">
        <input type="hidden" name="p" value="1">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="search" value="{{ search|default('') }}"
                   placeholder="Rechercher par nom, prénom ou email…" aria-label="Rechercher un étudiant">
        </div>
    </form>

    {# ===== TABLEAU ===== #}
    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Promotion</th>
                    <th>Candidatures</th>
                    <th>Statut recherche</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for student in students %}
                <tr>
                    <td><strong>{{ student.nom }}</strong></td>
                    <td>{{ student.prenom }}</td>
                    <td>{{ student.email }}</td>
                    <td>{{ student.promotion ?? '—' }}</td>
                    <td>{{ student.candidatures ?? 0 }}</td>
                    <td>
                        {% if student.status == 'ok' %}
                            <span class="badge badge--ok">Stage trouvé</span>
                        {% elseif student.status == 'no' %}
                            <span class="badge badge--no">Non trouvé</span>
                        {% else %}
                            <span class="badge badge--wait">En cours</span>
                        {% endif %}
                    </td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-view-etu" title="Voir les candidatures"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}"
                            data-email="{{ student.email }}"
                            data-candidatures="{{ student.candidatures_detail is defined and student.candidatures_detail ? student.candidatures_detail|e('html_attr') : '[]' }}">                            
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button class="btn-icon btn-edit-etu" title="Modifier"
                            data-id="{{ student.ID_profile }}"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}"
                            data-email="{{ student.email }}"
                            data-status="{{ student.status ?? 'wait' }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-delete-etu" title="Supprimer"
                            data-id="{{ student.ID_profile }}"
                            data-nom="{{ student.nom }}"
                            data-prenom="{{ student.prenom }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="7">Aucun étudiant trouvé.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ===== PAGINATION ===== #}
    <nav class="pagination" aria-label="Pagination des étudiants">

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="student_management">
            <input type="hidden" name="p" value="{{ pageCourante - 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante <= 1 %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </form>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <form method="get" action="/index.php">
                        <input type="hidden" name="page" value="student_management">
                        <input type="hidden" name="p" value="{{ p }}">
                        <input type="hidden" name="search" value="{{ search|default('') }}">
                        <button class="page-number {% if p == pageCourante %}active{% endif %}" type="submit">
                            {{ p }}
                        </button>
                    </form>
                {% endif %}
            {% endfor %}
        </div>

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="student_management">
            <input type="hidden" name="p" value="{{ pageCourante + 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante >= totalPages %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </form>

    </nav>

</main>

{# ===== DIALOG VOIR ===== #}
<dialog class="dialog" id="dialogViewEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo kpi-green"><i class="fa-solid fa-user-graduate"></i></div>
            <div>
                <h2 id="viewEtuTitle">—</h2>
                <p class="dialog-company" id="viewEtuInfo">—</p>
            </div>
            <button class="dialog-close" id="btnCloseViewEtu" type="button">✕</button>
        </header>
        <div style="margin-top:14px">
            <h3 style="margin:0 0 10px;font-size:15px">Candidatures envoyées</h3>
            <div class="table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr><th>Offre</th><th>Entreprise</th></tr>
                    </thead>
                    <tbody id="viewEtuTbody"></tbody>
                </table>
            </div>
        </div>
        <div class="dialog-actions" style="margin-top:14px">
            <button class="btn-secondary" id="btnCloseViewEtu2">Fermer</button>
        </div>
    </div>
</dialog>

{# ===== DIALOG CRÉER ===== #}
<dialog class="dialog dialog--sm" id="dialogCreateEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-user-plus"></i></div>
            <div><h2>Nouvel étudiant</h2><p class="dialog-company">Créer un compte étudiant.</p></div>
            <button class="dialog-close" id="btnCloseCreateEtu" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=student_management">
            <input type="hidden" name="action" value="create_student">
            <div class="field-group">
                <div class="field">
                    <label for="cNom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cNom" name="nom" type="text" placeholder="Nom" required></div>
                </div>
                <div class="field">
                    <label for="cPrenom">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cPrenom" name="prenom" type="text" placeholder="Prénom" required></div>
                </div>
            </div>
            <div class="field">
                <label for="cEmail">Email <span class="required">*</span></label>
                <div class="input">
                    <i class="fa-solid fa-envelope"></i>
                    <input id="cEmail" name="email" type="email" placeholder="prenom.nom@viacesi.fr" required>
                </div>
            </div>
            <div class="field">
                <label for="cPassword">Mot de passe <span class="required">*</span></label>
                <div class="input">
                    <i class="fa-solid fa-lock"></i>
                    <input id="cPassword" name="password" type="password" placeholder="Mot de passe" required>

                    <button type="button" class="toggle-password">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="field">
                <label for="cPromotion">Promotion</label>
                <div class="input">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <select id="cPromotion" name="id_promotion" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="">Sélectionner…</option>
                        {% for promo in promotions %}
                            <option value="{{ promo.ID_promotion }}">{{ promo.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelCreateEtu">Annuler</button>
                <button class="btn-voir" type="submit">Créer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG MODIFIER ===== #}
<dialog class="dialog dialog--sm" id="dialogEditEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-pen"></i></div>
            <div><h2>Modifier l'étudiant</h2><p class="dialog-company" id="editEtuSubtitle">—</p></div>
            <button class="dialog-close" id="btnCloseEditEtu" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=student_management">
            <input type="hidden" name="action" value="update_student">
            <input type="hidden" name="id_profile" id="eIdProfile">
            <div class="field-group">
                <div class="field">
                    <label for="eNom">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="eNom" name="nom" type="text" required></div>
                </div>
                <div class="field">
                    <label for="ePrenom">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="ePrenom" name="prenom" type="text" required></div>
                </div>
            </div>
            <div class="field">
                <label for="eEmail">Email <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-envelope"></i><input id="eEmail" name="email" type="email" required></div>
            </div>
            <div class="field">
                <label for="ePassword">Nouveau mot de passe</label>
                <div class="input">
                    <i class="fa-solid fa-lock"></i>
                    <input id="ePassword" name="password" type="password" placeholder="Laisser vide pour ne pas changer">
                </div>
            </div>
            <div class="field">
                <label for="ePromotion">Promotion</label>
                <div class="input">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <select id="ePromotion" name="id_promotion" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="">Aucune</option>
                        {% for promo in promotions %}
                            <option value="{{ promo.ID_promotion }}">{{ promo.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="field">
                <label for="eStatus">Statut de recherche</label>
                <div class="input">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <select id="eStatus" name="status" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="wait">En cours</option>
                        <option value="ok">Stage trouvé</option>
                        <option value="no">Non trouvé</option>
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelEditEtu">Annuler</button>
                <button class="btn-voir" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</dialog>

{# ===== DIALOG SUPPRIMER ===== #}
<dialog class="dialog dialog--sm" id="dialogDeleteEtu">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--danger"><i class="fa-solid fa-trash"></i></div>
            <div><h2>Supprimer l'étudiant</h2><p class="dialog-company" id="deleteEtuName">—</p></div>
            <button class="dialog-close" id="btnCloseDeleteEtu" type="button">✕</button>
        </header>
        <div class="dialog-confirm-body">
            <p>Cette action est <strong>irréversible</strong>. Le compte et toutes les données seront supprimés.</p>
        </div>
        <form method="post" action="/index.php?page=student_management">
            <input type="hidden" name="action" value="delete_student">
            <input type="hidden" name="id_profile" id="dIdProfile">
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelDeleteEtu">Annuler</button>
                <button class="btn-danger" type="submit">Supprimer</button>
            </div>
        </form>
    </div>
</dialog>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/javascript/student_management.js"></script>
{% endblock %}
