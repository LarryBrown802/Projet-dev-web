{% extends 'base.html.twig' %}

{% block metas %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Tableau de bord Admin - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Admin.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Tableau de bord Admin</h1>
            <p class="page-subtitle">Vue d'ensemble globale de la plateforme LEMS.</p>
        </div>
        <div class="page-meta">
            <div class="meta-card">
                <span class="meta-label">Rôle</span>
                <span class="meta-value" style="font-size:15px">Administrateur</span>
            </div>
        </div>
    </div>

    {# ===== KPIs ===== #}
    <div class="kpi-grid kpi-grid--5">
        <article class="kpi-card">
            <div class="kpi-icon kpi-blue"><i class="fa-solid fa-chalkboard-teacher"></i></div>
            <div><h2 class="kpi-label">Pilotes</h2><p class="kpi-value">{{ nbPilotes }}</p></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-green"><i class="fa-solid fa-user-graduate"></i></div>
            <div><h2 class="kpi-label">Étudiants</h2><p class="kpi-value">{{ nbEtudiants }}</p></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-yellow"><i class="fa-solid fa-building"></i></div>
            <div><h2 class="kpi-label">Entreprises</h2><p class="kpi-value">{{ nbEntreprises }}</p></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-purple"><i class="fa-solid fa-briefcase"></i></div>
            <div><h2 class="kpi-label">Offres</h2><p class="kpi-value">{{ nbOffres }}</p></div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-red"><i class="fa-solid fa-file-circle-check"></i></div>
            <div><h2 class="kpi-label">Candidatures</h2><p class="kpi-value">{{ nbCandidatures }}</p></div>
        </article>
    </div>

        {# ===== TABLEAUX ===== #}
        <section class="admin-main">

            {# Tableau offres #}
            <div class="section-head-row">
                <h2 class="section-title-dash">Vue d'ensemble des offres</h2>
                <a href="/index.php?page=offer_management" class="link-see-all">Voir tout <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <div class="table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Entreprise</th>
                            <th>Type</th>
                            <th>Niveau</th>
                            <th>Lieu</th>
                            <th>Rémun.</th>
                            <th>Candidatures</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for offer in latestOffers %}
                        <tr>
                            <td><strong>{{ offer.title }}</strong></td>
                            <td>{{ offer.entreprise }}</td>
                            <td>
                                {% if offer.type == 'Stage' %}
                                    <span class="tag-pill tag-stage">Stage</span>
                                {% else %}
                                    <span class="tag-pill tag-alt">Alternance</span>
                                {% endif %}
                            </td>
                            <td><span class="tag-pill tag-bac">{{ offer.level }}</span></td>
                            <td><span class="tag-pill tag-lieu">{{ offer.lieu }}</span></td>
                            <td>{{ offer.remuneration }} €</td>
                            <td>{{ offer.candidatures ?? 0 }}</td>
                        </tr>
                        {% else %}
                            <tr><td colspan="7">Aucune offre disponible.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Tableau pilotes #}
            <div class="section-head-row" style="margin-top:22px">
                <h2 class="section-title-dash">Pilotes enregistrés</h2>
                <a href="/index.php?page=pilot_admin" class="link-see-all">Voir tout <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <div class="table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Promotion</th>
                            <th>Étudiants</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for pilot in pilots %}
                        <tr>
                            <td><strong>{{ pilot.name }}</strong></td>
                            <td>{{ pilot.surname }}</td>
                            <td>{{ pilot.promotion ?? '—' }}</td>
                            <td>{{ pilot.nb_etudiants ?? 0 }}</td>
                        </tr>
                        {% else %}
                            <tr><td colspan="4">Aucun pilote enregistré.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </section>

</main>
{% endblock %}
