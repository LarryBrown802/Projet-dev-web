{% extends 'pages/base.html.twig' %}

{% block metas %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block title %}Gestion des pilotes - LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Admin.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Gestion des pilotes</h1>
            <p class="page-subtitle">Créer, modifier ou supprimer des comptes pilotes de promotion.</p>
        </div>
        <button class="btn-add" type="button" id="btnCreatePilote">
            <i class="fa-solid fa-plus"></i> Nouveau pilote
        </button>
    </div>

    <form method="get" action="/index.php" class="search-bar-wrap">
        <input type="hidden" name="page" value="pilot_admin">
        <input type="hidden" name="p" value="1">
        <div class="search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="search" value="{{ search|default('') }}" placeholder="Rechercher un pilote par nom ou prénom…">
        </div>
    </form>

    <div class="table-wrap">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Promotion</th>
                    <th>Étudiants</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for pilot in pilots %}
                <tr>
                    <td><strong>{{ pilot.name }}</strong></td>
                    <td>{{ pilot.surname }}</td>
                    <td>{{ pilot.email }}</td>
                    <td>{{ pilot.promotion ?? '—' }}</td>
                    <td>{{ pilot.nb_etudiants ?? 0 }}</td>
                    <td class="actions-cell">
                        <button class="btn-icon btn-edit" title="Modifier"
                            data-id="{{ pilot.ID_user }}"
                            data-name="{{ pilot.name }}"
                            data-surname="{{ pilot.surname }}"
                            data-email="{{ pilot.email }}"
                            data-id-promotion="{{ pilot.ID_promotion ?? '' }}">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button class="btn-icon btn-delete" title="Supprimer"
                            data-id="{{ pilot.ID_user }}"
                            data-name="{{ pilot.name }}"
                            data-surname="{{ pilot.surname }}">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
                {% else %}
                    <tr><td colspan="6">Aucun pilote trouvé.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <nav class="pagination" aria-label="Pagination des pilotes">

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="pilot_admin">
            <input type="hidden" name="p" value="{{ pageCourante - 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante <= 1 %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </form>

        <div class="page-numbers">
            {% for p in pages %}
                {% if p == '...' %}
                    <span class="page-ellipsis">…</span>
                {% else %}
                    <form method="get" action="/index.php">
                        <input type="hidden" name="page" value="pilot_admin">
                        <input type="hidden" name="p" value="{{ p }}">
                        <input type="hidden" name="search" value="{{ search|default('') }}">
                        <button class="page-number {% if p == pageCourante %}active{% endif %}" type="submit">
                            {{ p }}
                        </button>
                    </form>
                {% endif %}
            {% endfor %}
        </div>

        <form method="get" action="/index.php">
            <input type="hidden" name="page" value="pilot_admin">
            <input type="hidden" name="p" value="{{ pageCourante + 1 }}">
            <input type="hidden" name="search" value="{{ search|default('') }}">
            <button class="page-arrow" type="submit" {% if pageCourante >= totalPages %}disabled{% endif %}>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </form>

    </nav>
</main>

<!-- ===== DIALOG CRÉER ===== -->
<dialog class="dialog dialog--sm" id="dialogCreatePilote">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-user-plus"></i></div>
            <div><h2>Nouveau pilote</h2><p class="dialog-company">Créer un compte pilote.</p></div>
            <button class="dialog-close" id="btnCloseCreatePilote" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=pilot_admin">
            <input type="hidden" name="action" value="create">
            <div class="field-group">
                <div class="field">
                    <label for="cName">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cName" name="name" type="text" placeholder="Nom" required></div>
                </div>
                <div class="field">
                    <label for="cSurname">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="cSurname" name="surname" type="text" placeholder="Prénom" required></div>
                </div>
            </div>
            <div class="field">
                <label for="cEmail">Email <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-envelope"></i><input id="cEmail" name="email" type="email" placeholder="email@lems.fr" required></div>
            </div>
            <div class="field">
                <label for="cPassword">Mot de passe <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-lock"></i><input id="cPassword" name="password" type="password" placeholder="Mot de passe" required></div>
            </div>
            <div class="field">
                <label for="cPromotionExist">Promotion existante</label>
                <div class="input">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <select id="cPromotionExist" name="id_promotion" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="">Aucune</option>
                        {% for promo in promotions %}
                            <option value="{{ promo.ID_promotion }}">{{ promo.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="field">
                <label for="cPromotion">Ou créer une nouvelle promotion</label>
                <div class="input">
                    <i class="fa-solid fa-plus"></i>
                    <input id="cPromotion" name="promotion" type="text" placeholder="ex: CPI A2 Informatique">
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelCreatePilote">Annuler</button>
                <button class="btn-voir" type="submit">Créer</button>
            </div>
        </form>
    </div>
</dialog>

<!-- ===== DIALOG MODIFIER ===== -->
<dialog class="dialog dialog--sm" id="dialogEditPilote">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo"><i class="fa-solid fa-pen"></i></div>
            <div><h2>Modifier le pilote</h2><p class="dialog-company" id="editPiloteSubtitle">—</p></div>
            <button class="dialog-close" id="btnCloseEditPilote" type="button">✕</button>
        </header>
        <form class="dialog-form" method="post" action="/index.php?page=pilot_admin">
            <input type="hidden" name="action" value="update">
            <input type="hidden" name="id_user" id="eIdUser">
            <div class="field-group">
                <div class="field">
                    <label for="eName">Nom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="eName" name="name" type="text" required></div>
                </div>
                <div class="field">
                    <label for="eSurname">Prénom <span class="required">*</span></label>
                    <div class="input"><i class="fa-solid fa-user"></i><input id="eSurname" name="surname" type="text" required></div>
                </div>
            </div>
            <div class="field">
                <label for="eEmail">Email <span class="required">*</span></label>
                <div class="input"><i class="fa-solid fa-envelope"></i><input id="eEmail" name="email" type="email" required></div>
            </div>
            <div class="field">
                <label for="ePromotion">Promotion</label>
                <div class="input">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <select id="ePromotion" name="id_promotion" style="border:none;outline:none;width:100%;background:transparent;font-weight:800">
                        <option value="">Aucune</option>
                        {% for promo in promotions %}
                            <option value="{{ promo.ID_promotion }}">{{ promo.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelEditPilote">Annuler</button>
                <button class="btn-voir" type="submit">Enregistrer</button>
            </div>
        </form>
    </div>
</dialog>

<!-- ===== DIALOG SUPPRIMER ===== -->
<dialog class="dialog dialog--sm" id="dialogDeletePilote">
    <div class="dialog-inner">
        <header class="dialog-header">
            <div class="dialog-logo dialog-logo--danger"><i class="fa-solid fa-trash"></i></div>
            <div><h2>Supprimer le pilote</h2><p class="dialog-company" id="deletePiloteName">—</p></div>
            <button class="dialog-close" id="btnCloseDeletePilote" type="button">✕</button>
        </header>
        <div class="dialog-confirm-body">
            <p>Cette action est <strong>irréversible</strong>. Le compte sera définitivement supprimé.</p>
        </div>
        <form method="post" action="/index.php?page=pilot_admin">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="id_user" id="dIdUser">
            <div class="dialog-actions">
                <button class="btn-secondary" type="button" id="btnCancelDeletePilote">Annuler</button>
                <button class="btn-danger" type="submit">Supprimer</button>
            </div>
        </form>
    </div>
</dialog>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/assets/javascript/pilot_admin.js"></script>
{% endblock %}
