{% extends 'pages/base.html.twig' %}

{% block title %}Dashboard Pilote -LEMS{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/pages/Pilote.css">
{% endblock %}

{% block content %}
<main class="container">

    <div class="page-head">
        <div>
            <h1>Tableau de bord</h1>
            <p class="page-subtitle">
                Bienvenue, <strong>{{ profile.name ?? '' }} {{ profile.surname ?? '' }}</strong>
                {% if profile.promotion is defined and profile.promotion %}
                    — Pilote de promotion {{ profile.promotion }}
                {% endif %}
            </p>
        </div>
        <div class="page-meta">
            <div class="meta-card">
                <span class="meta-label">Promotion</span>
                <span class="meta-value">{{ profile.promotion ?? '—' }}</span>
            </div>
            <div class="meta-card">
                <span class="meta-label">Étudiants</span>
                <span class="meta-value">{{ profile.nb_etudiants ?? 0 }}</span>
            </div>
        </div>
    </div>

    {# ===== KPIs ===== #}
    <div class="kpi-grid" role="region" aria-label="Indicateurs clés">
        <article class="kpi-card">
            <div class="kpi-icon kpi-blue"><i class="fa-solid fa-file-circle-check"></i></div>
            <div>
                <h2 class="kpi-label">Candidatures totales</h2>
                <p class="kpi-value">{{ nbCandidatures }}</p>
            </div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-green"><i class="fa-solid fa-user-graduate"></i></div>
            <div>
                <h2 class="kpi-label">Étudiants</h2>
                <p class="kpi-value">{{ nbEtudiants }}</p>
            </div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-yellow"><i class="fa-solid fa-building"></i></div>
            <div>
                <h2 class="kpi-label">Entreprises partenaires</h2>
                <p class="kpi-value">{{ nbEntreprises }}</p>
            </div>
        </article>
        <article class="kpi-card">
            <div class="kpi-icon kpi-purple"><i class="fa-solid fa-briefcase"></i></div>
            <div>
                <h2 class="kpi-label">Offres disponibles</h2>
                <p class="kpi-value">{{ nbOffres }}</p>
            </div>
        </article>
    </div>

    {# ===== RACCOURCIS ===== #}
    <section class="dash-section">
        <h2 class="section-title-dash">Accès rapides</h2>
        <div class="shortcut-grid">
            <a href="/index.php?page=company_management" class="shortcut-card">
                <div class="shortcut-icon"><i class="fa-solid fa-building"></i></div>
                <span>Gérer les entreprises</span>
            </a>
            <a href="/index.php?page=offer_management" class="shortcut-card">
                <div class="shortcut-icon"><i class="fa-solid fa-briefcase"></i></div>
                <span>Gérer les offres</span>
            </a>
            <a href="/index.php?page=student_management" class="shortcut-card">
                <div class="shortcut-icon"><i class="fa-solid fa-user-graduate"></i></div>
                <span>Gérer les étudiants</span>
            </a>
        </div>
    </section>

    {# ===== DERNIÈRES OFFRES ===== #}
    <section class="dash-section">
        <div class="section-head-row">
            <h2 class="section-title-dash">Dernières offres disponibles</h2>
            <a href="/index.php?page=offer_management" class="link-see-all">Voir tout <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="table-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Entreprise</th>
                        <th>Type</th>
                        <th>Niveau</th>
                        <th>Lieu</th>
                        <th>Rémunération</th>
                        <th>Candidatures</th>
                    </tr>
                </thead>
                <tbody>
                    {% for offer in latestOffers %}
                    <tr>
                        <td><strong>{{ offer.title }}</strong></td>
                        <td>{{ offer.entreprise }}</td>
                        <td>
                            {% if offer.type == 'Stage' %}
                                <span class="tag-pill tag-stage">Stage</span>
                            {% else %}
                                <span class="tag-pill tag-alt">Alternance</span>
                            {% endif %}
                        </td>
                        <td><span class="tag-pill tag-bac">{{ offer.level }}</span></td>
                        <td><span class="tag-pill tag-lieu">{{ offer.lieu }}</span></td>
                        <td>{{ offer.remuneration }} €</td>
                        <td>{{ offer.candidatures ?? 0 }}</td>
                    </tr>
                    {% else %}
                        <tr><td colspan="7">Aucune offre disponible.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

</main>
{% endblock %}
