{% extends 'pages/base.html.twig' %}

{% block title %}Page introuvable - 404{% endblock %}

{% block content %}
<main class="container error-main error-404">
    <div class="error-icon">
        <i class="fa-solid fa-map-location-dot"></i>
    </div>
    <h1 class="error-title">404</h1>
    <h2 class="error-subtitle">Oups ! Page introuvable.</h2>
    <p class="error-text">
        Il semblerait que vous vous soyez perdu. La page que vous recherchez n'existe pas, a été déplacée ou l'URL est incorrecte.
    </p>
    <a href="/index.php?page=accueil" class="btn-primary error-link">
        <i class="fa-solid fa-house"></i> Retour à l'accueil
    </a>
</main>
{% endblock %}