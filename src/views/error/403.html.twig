{% extends 'pages/base.html.twig' %}

{% block title %}Accès refusé - 403{% endblock %}

{% block content %}
<main class="container error-main">
    <div class="error-icon">
        <i class="fa-solid fa-hand"></i>
    </div>
    <h1 class="error-title">403</h1>
    <h2 class="error-subtitle">Accès interdit.</h2>
    <p class="error-text">
        Désolé, votre rôle actuel ne vous donne pas les permissions nécessaires pour accéder à cette zone.
    </p>
    <a href="/index.php?page=accueil" class="btn-primary error-link">
        <i class="fa-solid fa-arrow-left"></i> Revenir en lieu sûr
    </a>
</main>
{% endblock %}